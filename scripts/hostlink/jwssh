#!/bin/bash
# jwssh PEER [command...]: use the first authenticated path: cable, Bonjour, Wi-Fi.
# Host aliases and trusted host keys must already be installed. No command retry:
# a lost connection after execution starts must never duplicate a remote action.
set -u
P=${1:-}
[[ $P == mbp || $P == air ]] || { echo "usage: jwssh mbp|air [command...]" >&2; exit 2; }
shift
opts=(-o BatchMode=yes -o ConnectTimeout=4 -o ConnectionAttempts=1
      -o ServerAliveInterval=20 -o ServerAliveCountMax=3)
for alias in "$P-ts" "$P-wired" "$P" "$P-ip"; do
  if /usr/bin/ssh "${opts[@]}" "$alias" true 2>/dev/null; then
    exec /usr/bin/ssh "${opts[@]}" "$alias" "$@"
  fi
done
echo "jwssh: $P unreachable on every path (wired, bonjour, ip); verify host keys and aliases locally" >&2
exit 255
