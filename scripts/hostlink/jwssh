#!/bin/bash
# jwssh PEER [command...]: SSH to the other JouleWise Mac over the first path that answers.
# PEER is mbp (from the Air) or air (from the MBP). Paths are tried in this order:
# Thunderbolt cable, then the Bonjour name, then the fixed Wi-Fi IP.
# Each alias is defined in ~/.ssh/config.
set -u
P=${1:?usage: jwssh mbp|air [command...]}; shift
for alias in "$P-wired" "$P" "$P-ip"; do
  if /usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=4 "$alias" true 2>/dev/null; then
    exec /usr/bin/ssh "$alias" "$@"
  fi
done
echo "jwssh: $P unreachable on every path (wired, bonjour, ip)" >&2
exit 255
