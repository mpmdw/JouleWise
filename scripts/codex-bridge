#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  scripts/codex-bridge new [PROMPT...]
  scripts/codex-bridge resume [--last|SESSION_ID] [PROMPT...]
  scripts/codex-bridge review [PROMPT...]

Prompt text may also be piped on stdin. The last Codex response is mirrored to
.codex-bridge/last-message.md for Claude Code to read or quote back.

Each invocation also writes a durable local audit trail under .codex-bridge/:
prompt snapshots, response snapshots, logs, status files, and
invocation_manifest.jsonl rows with prompt/output hashes and session ids.

Defaults: model gpt-5.6-sol, reasoning effort high. Callers select xhigh for
hard individual work or ultra only for sessions that must spawn subagents by
setting CODEX_REASONING_EFFORT deliberately.

Fast Mode is the DEFAULT tier (Ed, 2026-08-08). Opt out for one call with:
  CODEX_SERVICE_TIER=default scripts/codex-bridge new ...

When .codex-bridge/app-host-thread-id exists, new and review run their real
turn in that Codex desktop task so the native pet sees app-owned activity.
Set CODEX_APP_BRIDGE=off to require the standalone CLI transport.

Governed delegated runs follow docs/contracts/bridge_protocol.md: the prompt
begins with a BRIDGE_TASK_V1 header; audited runs that emit a full
claude-codex-report/v1 body are exempt from the bridge-report/v1 trailer.
USAGE
}

json_quote() {
  printf '"'
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
  printf '"'
}

now_utc() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

sha256_file() {
  if [[ -f "$1" ]]; then
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

session_id_from_log() {
  if [[ -f "$log_file" ]]; then
    sed -n 's/^session id: //p' "$log_file" 2>/dev/null | tail -n 1
  fi
}

prompt_preview() {
  if [[ -f "$prompt_file" ]]; then
    LC_ALL=C head -c 240 "$prompt_file" | tr '\n\r\t' '   '
  fi
}

observer_emit() {
  local event="$1"
  local status_text="$2"
  local session_id="$3"
  local message="$4"
  local timestamp preview

  mkdir -p "$observer_dir" 2>/dev/null || true
  timestamp="$(now_utc)"
  preview="$(prompt_preview)"
  {
    printf '{"schema_version":1'
    printf ',"event":%s' "$(json_quote "$event")"
    printf ',"timestamp":%s' "$(json_quote "$timestamp")"
    printf ',"run_key":%s' "$(json_quote "$run_id")"
    printf ',"session_id":%s' "$(json_quote "$session_id")"
    printf ',"status":%s' "$(json_quote "$status_text")"
    printf ',"message":%s' "$(json_quote "$message")"
    printf ',"cwd":%s' "$(json_quote "$repo_root")"
    printf ',"out":%s' "$(json_quote "$response_file")"
    printf ',"log":%s' "$(json_quote "$log_file")"
    printf ',"status_file":%s' "$(json_quote "$status_file")"
    printf ',"observer_file":%s' "$(json_quote "$observer_file")"
    printf ',"timeout_s":%s' "$(json_quote "")"
    printf ',"sandbox":%s' "$(json_quote "$observer_sandbox")"
    printf ',"resume":%s' "$(json_quote "$observer_resume")"
    printf ',"codex_pid":%s' "$(json_quote "$codex_pid")"
    printf ',"prompt_preview":%s' "$(json_quote "$preview")"
    printf ',"transport":%s' "$(json_quote "$bridge_transport")"
    printf ',"caller":%s' "$(json_quote "claude-code")"
    printf '}\n'
  } >> "$observer_index" 2>/dev/null || true
  {
    printf '{"schema_version":1'
    printf ',"event":%s' "$(json_quote "$event")"
    printf ',"timestamp":%s' "$(json_quote "$timestamp")"
    printf ',"run_key":%s' "$(json_quote "$run_id")"
    printf ',"session_id":%s' "$(json_quote "$session_id")"
    printf ',"status":%s' "$(json_quote "$status_text")"
    printf ',"message":%s' "$(json_quote "$message")"
    printf ',"cwd":%s' "$(json_quote "$repo_root")"
    printf ',"out":%s' "$(json_quote "$response_file")"
    printf ',"log":%s' "$(json_quote "$log_file")"
    printf ',"status_file":%s' "$(json_quote "$status_file")"
    printf ',"timeout_s":%s' "$(json_quote "")"
    printf ',"sandbox":%s' "$(json_quote "$observer_sandbox")"
    printf ',"resume":%s' "$(json_quote "$observer_resume")"
    printf ',"codex_pid":%s' "$(json_quote "$codex_pid")"
    printf ',"prompt_preview":%s' "$(json_quote "$preview")"
    printf ',"transport":%s' "$(json_quote "$bridge_transport")"
    printf ',"caller":%s' "$(json_quote "claude-code")"
    printf '}\n'
  } >> "$observer_file" 2>/dev/null || true
}

observer_session_ready_if_needed() {
  local session_id="$1"
  [[ -n "$session_id" ]] || return 0
  if [[ ! -f "$observer_file" ]] ||
    ! grep -Fq "\"session_id\":\"$session_id\"" "$observer_file"; then
    observer_emit "SESSION_READY" "RUNNING" "$session_id" "session id captured"
  fi
}

observer_watch_session_id() {
  local attempt session_id
  for ((attempt = 0; attempt < 120; attempt += 1)); do
    session_id="$(session_id_from_log || true)"
    if [[ -n "$session_id" ]]; then
      observer_session_ready_if_needed "$session_id"
      return 0
    fi
    kill -0 "$codex_pid" 2>/dev/null || return 0
    sleep 1
  done
  observer_emit "SESSION_PENDING" "RUNNING" "" \
    "session id not found within observer window"
}

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
bridge_dir="${CODEX_BRIDGE_DIR:-"$repo_root/.codex-bridge"}"
prompt_dir="$bridge_dir/prompts"
response_dir="$bridge_dir/responses"
mkdir -p "$bridge_dir" "$prompt_dir" "$response_dir"

codex_bin="${CODEX_BIN:-codex}"
codex_model="${CODEX_MODEL:-gpt-5.6-sol}"
codex_effort="${CODEX_REASONING_EFFORT:-high}"
codex_service_tier="${CODEX_SERVICE_TIER:-fast}"
case "$codex_service_tier" in
  default|fast) ;;
  *)
    printf 'Invalid CODEX_SERVICE_TIER: %s (expected default or fast)\n' \
      "$codex_service_tier" >&2
    exit 64
    ;;
esac
fresh_model_args=(-m "$codex_model" -c "model_reasoning_effort=$codex_effort" -c "service_tier=$codex_service_tier" -c "mcp_servers.claude.enabled=false")
resume_model_args=(-c "model=$codex_model" -c "model_reasoning_effort=$codex_effort" -c "service_tier=$codex_service_tier" -c "mcp_servers.claude.enabled=false")
last_message="$bridge_dir/last-message.md"
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
manifest_file="$bridge_dir/invocation_manifest.jsonl"
app_bridge_helper="$repo_root/scripts/codex-app-bridge.mjs"
app_host_file="${CODEX_APP_BRIDGE_HOST_FILE:-$bridge_dir/app-host-thread-id}"
app_bridge_enabled=0
app_host_thread_id=""
bridge_transport="cli-bridge"
if [[ "${CODEX_APP_BRIDGE:-auto}" != "off" && -s "$app_host_file" && -f "$app_bridge_helper" ]]; then
  app_host_thread_id="$(tr -d '[:space:]' < "$app_host_file")"
  if [[ -n "$app_host_thread_id" ]]; then
    app_bridge_enabled=1
  fi
fi

if [[ $# -lt 1 ]]; then
  usage
  exit 64
fi

mode="$1"
shift
run_id="$stamp-$$-$mode"
log_file="$bridge_dir/$run_id.log"
status_file="$bridge_dir/$run_id.status"
prompt_file="$prompt_dir/$run_id.prompt.txt"
response_file="$response_dir/$run_id.response.md"
observer_dir="${CODEX_OBSERVER_DIR:-${CODEX_HOME:-"$HOME/.codex"}/claude-spawned}"
observer_index="$observer_dir/index.jsonl"
observer_file="$bridge_dir/$run_id.codex-observer.jsonl"
target_session_id=""
prompt_source="none"
prompt_arg_count=0
started_at="$(now_utc)"
observer_sandbox="workspace-write"
observer_resume="0"
codex_pid=""
tee_pid=""
observer_watch_pid=""
bridge_pipe=""
observer_started=0
observer_finished=0

if [[ "$mode" == "review" ]]; then
  observer_sandbox="read-only"
elif [[ "$mode" == "resume" ]]; then
  observer_resume="1"
fi

cleanup_bridge() {
  local rc=$?
  if [[ "$observer_started" == "1" && "$observer_finished" == "0" ]]; then
    [[ -n "$codex_pid" ]] && kill "$codex_pid" 2>/dev/null || true
    [[ -n "$tee_pid" ]] && kill "$tee_pid" 2>/dev/null || true
    [[ -n "$observer_watch_pid" ]] && kill "$observer_watch_pid" 2>/dev/null || true
    [[ -n "$bridge_pipe" ]] && rm -f "$bridge_pipe"
    printf 'FAILED rc=%s\n' "$rc" > "$status_file" 2>/dev/null || true
    observer_session_ready_if_needed "$(session_id_from_log || true)"
    observer_emit "FINISHED" "FAILED rc=$rc" "$(session_id_from_log || true)" \
      "codex bridge wrapper exited before normal completion"
    observer_finished=1
  fi
}
trap cleanup_bridge EXIT

write_prompt_from_args() {
  prompt_source="argv"
  prompt_arg_count="$#"
  printf '%s\n' "$*" > "$prompt_file"
}

write_prompt_from_stdin() {
  prompt_source="stdin"
  prompt_arg_count=0
  cat > "$prompt_file"
}

write_empty_prompt() {
  prompt_source="none"
  prompt_arg_count=0
  : > "$prompt_file"
}

run_codex() {
  local stdin_file="$1"
  shift
  local rc

  bridge_pipe="$bridge_dir/.$run_id.output.pipe"
  rm -f "$bridge_pipe"
  mkfifo "$bridge_pipe"
  tee "$log_file" < "$bridge_pipe" &
  tee_pid=$!

  set +e
  if [[ -n "$stdin_file" ]]; then
    (cd "$repo_root" && exec "$codex_bin" "$@" < "$stdin_file") \
      > "$bridge_pipe" 2>&1 &
  else
    (cd "$repo_root" && exec "$codex_bin" "$@") > "$bridge_pipe" 2>&1 &
  fi
  codex_pid=$!
  printf 'RUNNING\n' > "$status_file"
  observer_started=1
  observer_emit "RUNNING" "RUNNING" "" "codex bridge process launched"
  if [[ -n "$target_session_id" && "$target_session_id" != "--last" ]]; then
    observer_session_ready_if_needed "$target_session_id"
  fi
  observer_watch_session_id &
  observer_watch_pid=$!

  wait "$codex_pid"
  rc=$?
  wait "$tee_pid" 2>/dev/null || true
  kill "$observer_watch_pid" 2>/dev/null || true
  wait "$observer_watch_pid" 2>/dev/null || true
  observer_session_ready_if_needed "$(session_id_from_log || true)"
  rm -f "$bridge_pipe"
  bridge_pipe=""
  set -e
  return "$rc"
}

run_app_codex() {
  local rc

  bridge_transport="desktop-thread-follower"
  target_session_id="$app_host_thread_id"
  bridge_pipe="$bridge_dir/.$run_id.output.pipe"
  rm -f "$bridge_pipe"
  mkfifo "$bridge_pipe"
  tee "$log_file" < "$bridge_pipe" &
  tee_pid=$!

  set +e
  (
    cd "$repo_root"
    exec node "$app_bridge_helper" \
      --thread-id "$app_host_thread_id" \
      --prompt-file "$prompt_file" \
      --output-file "$response_file" \
      --cwd "$repo_root" \
      --model "$codex_model" \
      --effort "$codex_effort" \
      --service-tier "$codex_service_tier" \
      --sandbox "$observer_sandbox" \
      --lock-file "$bridge_dir/app-host-thread.lock"
  ) > "$bridge_pipe" 2>&1 &
  codex_pid=$!
  printf 'RUNNING\n' > "$status_file"
  observer_started=1
  observer_emit "RUNNING" "RUNNING" "$app_host_thread_id" \
    "Codex desktop bridge turn launched"
  observer_session_ready_if_needed "$app_host_thread_id"

  wait "$codex_pid"
  rc=$?
  wait "$tee_pid" 2>/dev/null || true
  rm -f "$bridge_pipe"
  bridge_pipe=""
  set -e
  return "$rc"
}

finish_invocation() {
  local rc="$1"
  local finished_at status prompt_sha output_sha log_sha session_id preview

  finished_at="$(now_utc)"
  if [[ "$rc" -eq 0 ]]; then
    status="OK"
  else
    status="FAILED rc=$rc"
  fi
  printf '%s\n' "$status" > "$status_file"

  if [[ -f "$response_file" ]]; then
    cp "$response_file" "$last_message"
  else
    : > "$response_file"
    : > "$last_message"
  fi

  prompt_sha="$(sha256_file "$prompt_file")"
  output_sha="$(sha256_file "$response_file")"
  log_sha="$(sha256_file "$log_file")"
  session_id="$(session_id_from_log)"
  preview="$(prompt_preview)"
  observer_session_ready_if_needed "$session_id"
  observer_emit "FINISHED" "$status" "$session_id" "codex bridge process exited"
  observer_finished=1

  {
    printf '{"schema_version":1'
    printf ',"run_id":%s' "$(json_quote "$run_id")"
    printf ',"tool":%s' "$(json_quote "scripts/codex-bridge")"
    printf ',"transport":%s' "$(json_quote "$bridge_transport")"
    printf ',"mode":%s' "$(json_quote "$mode")"
    printf ',"started_at":%s' "$(json_quote "$started_at")"
    printf ',"finished_at":%s' "$(json_quote "$finished_at")"
    printf ',"status":%s' "$(json_quote "$status")"
    printf ',"exit_code":%s' "$(json_quote "$rc")"
    printf ',"repo_root":%s' "$(json_quote "$repo_root")"
    printf ',"codex_bin":%s' "$(json_quote "$codex_bin")"
    printf ',"model":%s' "$(json_quote "$codex_model")"
    printf ',"reasoning_effort":%s' "$(json_quote "$codex_effort")"
    printf ',"service_tier":%s' "$(json_quote "$codex_service_tier")"
    printf ',"session_id":%s' "$(json_quote "$session_id")"
    printf ',"target_session_id":%s' "$(json_quote "$target_session_id")"
    printf ',"prompt_source":%s' "$(json_quote "$prompt_source")"
    printf ',"prompt_arg_count":%s' "$(json_quote "$prompt_arg_count")"
    printf ',"prompt_path":%s' "$(json_quote "$prompt_file")"
    printf ',"prompt_sha256":%s' "$(json_quote "$prompt_sha")"
    printf ',"prompt_preview":%s' "$(json_quote "$preview")"
    printf ',"output_path":%s' "$(json_quote "$response_file")"
    printf ',"output_sha256":%s' "$(json_quote "$output_sha")"
    printf ',"last_message_path":%s' "$(json_quote "$last_message")"
    printf ',"log_path":%s' "$(json_quote "$log_file")"
    printf ',"log_sha256":%s' "$(json_quote "$log_sha")"
    printf ',"status_file":%s' "$(json_quote "$status_file")"
    printf ',"observer_file":%s' "$(json_quote "$observer_file")"
    printf ',"observer_index":%s' "$(json_quote "$observer_index")"
    printf ',"consumed_by":%s' "$(json_quote "")"
    printf ',"disposition":%s' "$(json_quote "pending")"
    printf ',"commit_or_pr":%s' "$(json_quote "")"
    printf '}\n'
  } >> "$manifest_file"
}

run_and_record() {
  local rc
  if run_codex "$@"; then
    rc=0
  else
    rc=$?
  fi
  finish_invocation "$rc"
  return "$rc"
}

run_app_and_record() {
  local rc
  if run_app_codex; then
    rc=0
  else
    rc=$?
  fi
  finish_invocation "$rc"
  return "$rc"
}

case "$mode" in
  new)
    if [[ $# -gt 0 ]]; then
      write_prompt_from_args "$@"
    else
      write_prompt_from_stdin
    fi
    if [[ "$app_bridge_enabled" == "1" ]]; then
      run_app_and_record
    elif [[ "$prompt_source" == "argv" ]]; then
      run_and_record "" exec "${fresh_model_args[@]}" -C "$repo_root" -s workspace-write -o "$response_file" "$*"
    else
      run_and_record "$prompt_file" exec "${fresh_model_args[@]}" -C "$repo_root" -s workspace-write -o "$response_file" -
    fi
    ;;
  resume)
    if [[ $# -eq 0 ]]; then
      target_session_id="--last"
      write_empty_prompt
      run_and_record "" exec "${resume_model_args[@]}" resume --last -o "$response_file"
    elif [[ "$1" == "--last" ]]; then
      shift
      target_session_id="--last"
      if [[ $# -gt 0 ]]; then
        write_prompt_from_args "$@"
        run_and_record "" exec "${resume_model_args[@]}" resume --last -o "$response_file" "$*"
      else
        write_prompt_from_stdin
        run_and_record "$prompt_file" exec "${resume_model_args[@]}" resume --last -o "$response_file" -
      fi
    else
      session_id="$1"
      shift
      target_session_id="$session_id"
      if [[ $# -gt 0 ]]; then
        write_prompt_from_args "$@"
        run_and_record "" exec "${resume_model_args[@]}" resume -o "$response_file" "$session_id" "$*"
      else
        write_prompt_from_stdin
        run_and_record "$prompt_file" exec "${resume_model_args[@]}" resume -o "$response_file" "$session_id" -
      fi
    fi
    ;;
  review)
    if [[ $# -gt 0 ]]; then
      write_prompt_from_args "$@"
    else
      write_prompt_from_stdin
    fi
    if [[ "$app_bridge_enabled" == "1" ]]; then
      run_app_and_record
    elif [[ "$prompt_source" == "argv" ]]; then
      run_and_record "" exec "${fresh_model_args[@]}" review -o "$response_file" "$*"
    else
      run_and_record "$prompt_file" exec "${fresh_model_args[@]}" review -o "$response_file" -
    fi
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown mode: $mode" >&2
    usage >&2
    exit 64
    ;;
esac
