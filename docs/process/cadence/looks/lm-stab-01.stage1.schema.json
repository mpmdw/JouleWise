{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:joulewise:cadence-description:lm-stab-01.stage1",
  "description": "Energy-blind census keyed by exact kit ID and planned leg.",
  "type": "object",
  "required": [
    "look_id",
    "source_snapshot",
    "counts",
    "positions",
    "by_kit",
    "token_table",
    "paper_wording"
  ],
  "properties": {
    "look_id": {
      "enum": [
        "lm-stab-01",
        "lm-stab-02"
      ]
    },
    "source_snapshot": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "receipt_commit",
            "input_hashes_sha256"
          ],
          "properties": {
            "receipt_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "input_hashes_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "receipt_commit",
            "input_hashes_sha256",
            "kit_index_sha256"
          ],
          "properties": {
            "receipt_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "input_hashes_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kit_index_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "n_legs",
        "n_local_dates"
      ],
      "properties": {
        "n_legs": {
          "type": "integer",
          "minimum": 0
        },
        "n_local_dates": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "positions": {
      "type": "object",
      "patternProperties": {
        "^f2-(inst|stab)-[0-9]{2}/L(00[1-9]|01[0-2])$": {
          "$ref": "#/$defs/position"
        }
      },
      "additionalProperties": false
    },
    "by_kit": {
      "type": "object",
      "patternProperties": {
        "^f2-(inst|stab)-[0-9]{2}$": {
          "type": "object",
          "required": [],
          "properties": {
            "qualified": {
              "type": "integer",
              "minimum": 1
            },
            "not_qualified:loaded": {
              "type": "integer",
              "minimum": 1
            },
            "short": {
              "type": "integer",
              "minimum": 1
            },
            "unreleased": {
              "type": "integer",
              "minimum": 1
            },
            "short_hold": {
              "type": "integer",
              "minimum": 1
            },
            "cap_not_reached": {
              "type": "integer",
              "minimum": 1
            },
            "wrong_mode": {
              "type": "integer",
              "minimum": 1
            },
            "incomplete": {
              "type": "integer",
              "minimum": 1
            },
            "dropped": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "token_table": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "paper_wording": {
      "enum": [
        "the same work",
        "the same cell of work"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "position": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "disposition",
            "loaded_flag",
            "receipt",
            "span_id",
            "attempt",
            "span_leg_index"
          ],
          "properties": {
            "disposition": {
              "enum": [
                "qualified",
                "not_qualified:loaded",
                "short",
                "unreleased",
                "short_hold",
                "cap_not_reached",
                "wrong_mode",
                "incomplete"
              ]
            },
            "loaded_flag": {
              "type": "boolean"
            },
            "receipt": {
              "type": "string",
              "minLength": 1
            },
            "span_id": {
              "type": "string",
              "minLength": 1
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            },
            "span_leg_index": {
              "description": "Zero-based index in the authenticated span receipt.",
              "const": 0
            },
            "over_time_budget": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "disposition",
            "loaded_flag",
            "drop"
          ],
          "properties": {
            "disposition": {
              "const": "dropped"
            },
            "loaded_flag": {
              "type": "null"
            },
            "drop": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "token": {
      "type": "object",
      "required": [
        "kit_id",
        "kit_sha256",
        "span_id",
        "attempt",
        "position",
        "leg_id",
        "nominal_prefill_tokens",
        "decode_cap",
        "realised_prefill_tokens",
        "realised_decode_tokens",
        "local_t0_date",
        "leg_status",
        "decode_cap_reached",
        "loaded_flag",
        "disposition",
        "missing_count_reason"
      ],
      "properties": {
        "kit_id": {
          "type": "string",
          "pattern": "^f2-stab-[0-9]{2}$"
        },
        "kit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "span_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "leg_id": {
          "type": "string",
          "pattern": "^L(00[1-9]|01[0-2])$"
        },
        "nominal_prefill_tokens": {
          "enum": [
            256,
            2000,
            19458
          ]
        },
        "decode_cap": {
          "const": 512
        },
        "realised_prefill_tokens": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "realised_decode_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "local_t0_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "leg_status": {
          "type": "string",
          "minLength": 1
        },
        "decode_cap_reached": {
          "type": "boolean"
        },
        "loaded_flag": {
          "type": "boolean"
        },
        "disposition": {
          "enum": [
            "qualified",
            "not_qualified:loaded",
            "short",
            "unreleased",
            "short_hold",
            "cap_not_reached",
            "wrong_mode",
            "incomplete"
          ]
        },
        "missing_count_reason": {
          "description": "Reason the position lacks an eligible count pair. The recorded counts are retained for a loaded leg.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
