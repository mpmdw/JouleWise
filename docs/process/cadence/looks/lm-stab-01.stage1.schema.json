{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:joulewise:cadence-description:lm-stab-01.stage1",
  "description": "Energy-blind census keyed by exact kit ID and planned leg.",
  "type": "object",
  "required": [
    "look_id",
    "source_snapshot",
    "counts",
    "positions",
    "by_kit",
    "token_table",
    "paper_wording"
  ],
  "properties": {
    "look_id": {
      "enum": [
        "lm-stab-01",
        "lm-stab-02"
      ]
    },
    "source_snapshot": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "receipt_commit",
            "input_hashes_sha256"
          ],
          "properties": {
            "receipt_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "input_hashes_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "receipt_commit",
            "input_hashes_sha256",
            "kit_index_sha256"
          ],
          "properties": {
            "receipt_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "input_hashes_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kit_index_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "n_legs",
        "n_local_dates"
      ],
      "properties": {
        "n_legs": {
          "type": "integer",
          "minimum": 0
        },
        "n_local_dates": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "positions": {
      "type": "object",
      "patternProperties": {
        "^f2-(inst|stab)-[0-9]{2}/L(00[1-9]|01[0-2])$": {
          "$ref": "#/$defs/position"
        }
      },
      "additionalProperties": false
    },
    "by_kit": {
      "type": "object",
      "patternProperties": {
        "^f2-(inst|stab)-[0-9]{2}$": {
          "type": "object",
          "required": [],
          "properties": {
            "qualified": {
              "type": "integer",
              "minimum": 1
            },
            "not_qualified:wrong_mode": {
              "type": "integer",
              "minimum": 1
            },
            "not_qualified:incomplete": {
              "type": "integer",
              "minimum": 1
            },
            "not_qualified:unreleased": {
              "type": "integer",
              "minimum": 1
            },
            "not_qualified:short_hold": {
              "type": "integer",
              "minimum": 1
            },
            "not_qualified:loaded": {
              "type": "integer",
              "minimum": 1
            },
            "not_qualified:short": {
              "type": "integer",
              "minimum": 1
            },
            "not_qualified:cap_not_reached": {
              "type": "integer",
              "minimum": 1
            },
            "dropped:ended_without_member": {
              "type": "integer",
              "minimum": 1
            },
            "dropped:queue_retired": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "token_table": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "paper_wording": {
      "enum": [
        "the same work",
        "the same cell of work"
      ]
    },
    "by_kit_set": {
      "type": "object",
      "required": [
        "all",
        "base14"
      ],
      "properties": {
        "all": {
          "$ref": "#/$defs/kit_set_counts"
        },
        "base14": {
          "$ref": "#/$defs/kit_set_counts"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "position": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "disposition",
            "reasons",
            "loaded_flag",
            "receipt",
            "span_id",
            "attempt",
            "span_leg_index",
            "over_time_budget",
            "runner_pin"
          ],
          "properties": {
            "disposition": {
              "$ref": "#/$defs/member_disposition"
            },
            "reasons": {
              "description": "Stage-1 eligibility failures in provisional lifecycle order.",
              "type": "array",
              "items": {
                "enum": [
                  "wrong_mode",
                  "incomplete",
                  "unreleased",
                  "short_hold",
                  "loaded",
                  "short",
                  "cap_not_reached"
                ]
              },
              "uniqueItems": true
            },
            "loaded_flag": {
              "type": "boolean"
            },
            "receipt": {
              "type": "string",
              "minLength": 1
            },
            "span_id": {
              "type": "string",
              "minLength": 1
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            },
            "span_leg_index": {
              "description": "Zero-based index in the authenticated span receipt.",
              "const": 0
            },
            "over_time_budget": {
              "type": "boolean"
            },
            "runner_pin": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false,
          "if": {
            "properties": {
              "disposition": {
                "const": "qualified"
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "disposition",
            "loaded_flag",
            "drop"
          ],
          "properties": {
            "disposition": {
              "enum": [
                "dropped:ended_without_member",
                "dropped:queue_retired"
              ]
            },
            "loaded_flag": {
              "type": "null"
            },
            "drop": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "token": {
      "type": "object",
      "required": [
        "kit_id",
        "kit_sha256",
        "span_id",
        "attempt",
        "position",
        "leg_id",
        "nominal_prefill_tokens",
        "decode_cap",
        "realised_prefill_tokens",
        "realised_decode_tokens",
        "local_t0_date",
        "leg_status",
        "decode_cap_reached",
        "loaded_flag",
        "disposition",
        "missing_count_reason",
        "runner_pin"
      ],
      "properties": {
        "kit_id": {
          "type": "string",
          "pattern": "^f2-stab-[0-9]{2}$"
        },
        "kit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "span_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "leg_id": {
          "type": "string",
          "pattern": "^L(00[1-9]|01[0-2])$"
        },
        "nominal_prefill_tokens": {
          "enum": [
            256,
            2000,
            19458
          ]
        },
        "decode_cap": {
          "const": 512
        },
        "realised_prefill_tokens": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "realised_decode_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "local_t0_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "leg_status": {
          "type": "string",
          "minLength": 1
        },
        "decode_cap_reached": {
          "type": "boolean"
        },
        "loaded_flag": {
          "type": "boolean"
        },
        "disposition": {
          "$ref": "#/$defs/member_disposition"
        },
        "missing_count_reason": {
          "description": "Reason the position lacks an eligible count pair. The recorded counts are retained for a loaded leg.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "runner_pin": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "member_disposition": {
      "enum": [
        "qualified",
        "not_qualified:wrong_mode",
        "not_qualified:incomplete",
        "not_qualified:unreleased",
        "not_qualified:short_hold",
        "not_qualified:loaded",
        "not_qualified:short",
        "not_qualified:cap_not_reached"
      ]
    },
    "kit_set_counts": {
      "type": "object",
      "required": [
        "n_legs",
        "n_local_dates",
        "by_runner_pin"
      ],
      "properties": {
        "n_legs": {
          "type": "integer",
          "minimum": 0
        },
        "n_local_dates": {
          "type": "integer",
          "minimum": 0
        },
        "by_runner_pin": {
          "type": "object",
          "patternProperties": {
            "^[0-9a-f]{40}$": {
              "$ref": "#/properties/counts"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "if": {
    "properties": {
      "look_id": {
        "const": "lm-stab-02"
      }
    }
  },
  "then": {
    "required": [
      "by_kit_set"
    ],
    "properties": {
      "source_snapshot": {
        "required": [
          "kit_index_sha256"
        ]
      }
    }
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "by_kit_set"
          ]
        },
        {
          "properties": {
            "source_snapshot": {
              "required": [
                "kit_index_sha256"
              ]
            }
          }
        }
      ]
    }
  }
}
