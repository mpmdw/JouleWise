{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "look_id",
    "manifest_sha256",
    "commit",
    "stage1_sha256",
    "n_legs"
  ],
  "properties": {
    "look_id": {
      "type": "string",
      "const": "lm-ctl-01"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "stage1_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "n_legs": {
      "type": "integer",
      "minimum": 0
    }
  }
}
