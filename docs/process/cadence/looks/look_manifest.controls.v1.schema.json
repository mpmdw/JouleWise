          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "print_code": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "print_code/analysis": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "print_code/attribution": {
