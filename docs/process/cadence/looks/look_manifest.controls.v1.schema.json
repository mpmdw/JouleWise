{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "look_id",
    "look_kind",
    "kit_id",
    "pins"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "joulewise.cadence_look_manifest.controls.v1"
    },
    "status": {
      "type": "string",
      "const": "final"
    },
    "look_id": {
      "type": "string",
      "const": "lm-ctl-01"
    },
    "look_kind": {
      "type": "string",
      "const": "controls"
    },
    "kit_id": {
      "type": "string",
      "const": "cl-ctl-01"
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controls_route",
        "edges",
        "hold",
        "instrument_floor_schema",
        "instrument_manifest",
        "output_schema",
        "print_code",
        "print_code/analysis",
        "print_code/attribution",
        "print_code/branch_release",
        "print_code/dispatch",
        "print_code/integrator",
        "print_code/manifest",
        "print_code/manifest_json",
        "print_code/phase",
        "print_code/powermetrics_adapter",
        "print_code/projection",
        "print_code/records",
        "print_code/trace_point",
        "print_code/windows",
        "restricted_schema"
      ],
      "properties": {
        "controls_route": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "edges": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hold": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
