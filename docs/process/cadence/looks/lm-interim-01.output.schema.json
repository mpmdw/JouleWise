{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "joulewise.cadence_look_output.interim.v1",
 "title": "Interim look output (lm-interim-01): the fit (level O), step 3's statistic and the decisions",
 "$comment": "No High Power table: RL-167 section 3 moved it to look lm-hp-01.",
 "description": "DRAFT, part of freeze 1 (RL-149 section 2.6 item 1; RL-150 R4; RL-166). The lead checks the look's output against this schema before anyone reads it (RL-149 section 2.6). Closed at every level. fit embeds level O of the analyst seat's interface exactly; step3 is step3_roster.py's file; decisions are read from those two. No joule or watt per leg, turn or block (RL-166 Q16). Field-level conventions under the research lead's open readings (R-10 to R-21) are the interface's and are not restated here.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "allow_draft",
  "decisions",
  "disclosure",
  "fit",
  "look_id",
  "manifest_sha256",
  "realized_prompt_tokens",
  "schema",
  "stage1_sha256",
  "step3",
  "synthetic"
 ],
 "properties": {
  "schema": {
   "const": "joulewise.cadence_look_output.interim.v1"
  },
  "look_id": {
   "const": "lm-interim-01"
  },
  "manifest_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "stage1_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "fit": {
   "$ref": "#/$defs/fit_output"
  },
  "step3": {
   "$ref": "#/$defs/step3_output"
  },
  "allow_draft": {
   "type": "boolean",
   "description": "assembled under --allow-draft; validate --output refuses it on non-synthetic input (Mythos N2)"
  },
  "synthetic": {
   "type": "boolean"
  },
  "realized_prompt_tokens": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "leg_key",
     "nominal",
     "realized"
    ],
    "properties": {
     "leg_key": {
      "type": "string"
     },
     "nominal": {
      "type": "integer"
     },
     "realized": {
      "type": "integer"
     }
    }
   },
   "description": "RL-158 Q5: legs whose realized prompt count is more than 5 % from nominal, computed by assemble from stage 1's legs"
  },
  "decisions": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "drift_tripwire",
    "extension_rule",
    "qualified_interim_half"
   ],
   "properties": {
    "drift_tripwire": {
     "enum": [
      "within",
      "to the research lead",
      "not_evaluable"
     ]
    },
    "qualified_interim_half": {
     "enum": [
      "passes",
      "fails",
      "not_evaluable"
     ]
    },
    "extension_rule": {
     "const": "none written; any extension needs a ruling"
    }
   }
  },
  "disclosure": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "analyst_seat",
    "code_sha256",
    "date",
    "holds_cleared",
    "numpy_version",
    "stage1_sha256",
    "statement"
   ],
   "properties": {
    "date": {
     "type": "string"
    },
    "code_sha256": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    },
    "stage1_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "analyst_seat": {
     "type": "string"
    },
    "numpy_version": {
     "type": "string"
    },
    "statement": {
     "type": "string"
    },
    "holds_cleared": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "cleared_by",
       "flag"
      ],
      "properties": {
       "flag": {
        "enum": [
         "onsets_before_116_s.to_research_lead",
         "meter_clock.to_research_lead",
         "tripwires.any"
        ]
       },
       "cleared_by": {
        "type": "string",
        "pattern": "^RL-\\d+[a-z]?"
       }
      }
     },
     "description": "RL-166c section 2 row 7 and RL-166 Q8: the fit does not refuse on P-4's or R-20's flag or on Q8's tripwires; the lead holds stage 2 while any is true in stage 1's file until the research lead clears it. One entry per flag that was true, naming the clearing ruling; [] when none was."
    }
   }
  }
 },
 "$defs": {
  "fit_output": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "allow_draft",
    "channels",
    "code_sha256",
    "delta_column",
    "look_id",
    "manifest_sha256",
    "numpy_version",
    "qualified_interim_half",
    "schema",
    "stage1_sha256",
    "synthetic",
    "tau_uncertainty_propagated"
   ],
   "properties": {
    "schema": {
     "const": "joulewise.cadence_look_fit.v1"
    },
    "look_id": {
     "const": "lm-interim-01"
    },
    "stage1_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "synthetic": {
     "type": "boolean"
    },
    "manifest_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$",
     "description": "the manifest verify_pins checked before stage 2 opened anything (Sol N2)"
    },
    "allow_draft": {
     "type": "boolean",
     "description": "the run used --allow-draft (synthetic only; Mythos N2)"
    },
    "code_sha256": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    },
    "numpy_version": {
     "type": "string"
    },
    "tau_uncertainty_propagated": {
     "const": false
    },
    "delta_column": {
     "enum": [
      "kept",
      "dropped_onset_not_estimable"
     ]
    },
    "channels": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "dc_in",
      "gpu_rail"
     ],
     "properties": {
      "gpu_rail": {
       "$ref": "#/$defs/channel_fit"
      },
      "dc_in": {
       "$ref": "#/$defs/channel_fit"
      }
     }
    },
    "qualified_interim_half": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "statistic",
      "threshold",
      "value",
      "verdict"
     ],
     "properties": {
      "statistic": {
       "const": "gpu_rail.lodo.hot.max_abs"
      },
      "value": {
       "type": [
        "number",
        "null"
       ]
      },
      "threshold": {
       "const": 0.02
      },
      "verdict": {
       "enum": [
        "passes",
        "fails",
        "not_evaluable"
       ]
      }
     }
    }
   },
   "description": "Level O of the analyst seat's data interface (docs/process/cadence_look_fit_interface.md section 4, PR #795), embedded exactly. scripts/cadence_look_run.py stage2 writes this object."
  },
  "channel_fit": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "coefficients",
    "columns",
    "covariance",
    "day_detail",
    "fold_coefficients",
    "lodo",
    "marked_sensitivity",
    "model_sha256",
    "n_days",
    "n_legs",
    "n_segments",
    "onset_offset_residuals",
    "prefix_bias",
    "qualified",
    "residuals",
    "trace_coverage"
   ],
   "properties": {
    "columns": {
     "type": "array",
     "items": {
      "enum": [
       "p1",
       "p2",
       "a0",
       "a1",
       "a2",
       "k_tf08",
       "k_fan",
       "k_tv0h",
       "delta"
      ]
     },
     "minItems": 5,
     "maxItems": 9,
     "uniqueItems": true
    },
    "coefficients": {
     "type": "object",
     "additionalProperties": {
      "type": "number"
     }
    },
    "covariance": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": "number"
      }
     }
    },
    "n_legs": {
     "type": "integer"
    },
    "n_segments": {
     "type": "integer"
    },
    "n_days": {
     "type": "integer"
    },
    "lodo": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "folds_delta_dropped",
      "hot",
      "hot_rms_over_legs",
      "leg",
      "no_heat"
     ],
     "properties": {
      "hot": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "counted_days",
        "max_abs",
        "n_hot_legs_per_day",
        "per_day",
        "pooled",
        "verdict"
       ],
       "properties": {
        "per_day": {
         "type": "object",
         "additionalProperties": {
          "type": "number"
         }
        },
        "counted_days": {
         "type": "array",
         "items": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         }
        },
        "n_hot_legs_per_day": {
         "type": "object",
         "additionalProperties": {
          "type": "integer"
         }
        },
        "max_abs": {
         "type": [
          "number",
          "null"
         ]
        },
        "pooled": {
         "type": [
          "number",
          "null"
         ]
        },
        "verdict": {
         "enum": [
          "passes",
          "fails",
          "not_evaluable"
         ]
        }
       }
      },
      "leg": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "per_day",
        "pooled",
        "rms_over_legs"
       ],
       "properties": {
        "per_day": {
         "type": "object",
         "additionalProperties": {
          "type": "number"
         }
        },
        "pooled": {
         "type": "number"
        },
        "rms_over_legs": {
         "type": "number"
        }
       }
      },
      "hot_rms_over_legs": {
       "type": [
        "number",
        "null"
       ]
      },
      "folds_delta_dropped": {
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
       }
      },
      "no_heat": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "hot",
        "hot_rms_over_legs",
        "leg"
       ],
       "properties": {
        "hot": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "counted_days",
          "max_abs",
          "n_hot_legs_per_day",
          "per_day",
          "pooled",
          "verdict"
         ],
         "properties": {
          "per_day": {
           "type": "object",
           "additionalProperties": {
            "type": "number"
           }
          },
          "counted_days": {
           "type": "array",
           "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
           }
          },
          "n_hot_legs_per_day": {
           "type": "object",
           "additionalProperties": {
            "type": "integer"
           }
          },
          "max_abs": {
           "type": [
            "number",
            "null"
           ]
          },
          "pooled": {
           "type": [
            "number",
            "null"
           ]
          },
          "verdict": {
           "enum": [
            "passes",
            "fails",
            "not_evaluable"
           ]
          }
         }
        },
        "leg": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "per_day",
          "pooled",
          "rms_over_legs"
         ],
         "properties": {
          "per_day": {
           "type": "object",
           "additionalProperties": {
            "type": "number"
           }
          },
          "pooled": {
           "type": "number"
          },
          "rms_over_legs": {
           "type": "number"
          }
         }
        },
        "hot_rms_over_legs": {
         "type": [
          "number",
          "null"
         ]
        }
       }
      }
     }
    },
    "prefix_bias": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "1.10",
      "1.30",
      "1.374"
     ],
     "properties": {
      "1.10": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "ci90",
        "estimate",
        "n_days",
        "n_pairs",
        "prefix_len"
       ],
       "properties": {
        "prefix_len": {
         "const": 3724
        },
        "estimate": {
         "type": [
          "number",
          "null"
         ]
        },
        "ci90": {
         "oneOf": [
          {
           "type": "null"
          },
          {
           "type": "array",
           "items": {
            "type": "number"
           },
           "minItems": 2,
           "maxItems": 2
          }
         ]
        },
        "n_pairs": {
         "type": "integer"
        },
        "n_days": {
         "type": "integer"
        }
       }
      },
      "1.30": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "ci90",
        "estimate",
        "n_days",
        "n_pairs",
        "prefix_len"
       ],
       "properties": {
        "prefix_len": {
         "const": 3151
        },
        "estimate": {
         "type": [
          "number",
          "null"
         ]
        },
        "ci90": {
         "oneOf": [
          {
           "type": "null"
          },
          {
           "type": "array",
           "items": {
            "type": "number"
           },
           "minItems": 2,
           "maxItems": 2
          }
         ]
        },
        "n_pairs": {
         "type": "integer"
        },
        "n_days": {
         "type": "integer"
        }
       }
      },
      "1.374": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "ci90",
        "estimate",
        "n_days",
        "n_pairs",
        "prefix_len"
       ],
       "properties": {
        "prefix_len": {
         "const": 2981
        },
        "estimate": {
         "type": [
          "number",
          "null"
         ]
        },
        "ci90": {
         "oneOf": [
          {
           "type": "null"
          },
          {
           "type": "array",
           "items": {
            "type": "number"
           },
           "minItems": 2,
           "maxItems": 2
          }
         ]
        },
        "n_pairs": {
         "type": "integer"
        },
        "n_days": {
         "type": "integer"
        }
       }
      }
     }
    },
    "residuals": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "hot_stretch",
      "leg"
     ],
     "properties": {
      "leg": {
       "type": "object",
       "additionalProperties": {
        "type": "number"
       }
      },
      "hot_stretch": {
       "type": "object",
       "additionalProperties": {
        "type": [
         "number",
         "null"
        ]
       }
      }
     }
    },
    "marked_sensitivity": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "coefficients_without",
      "lodo_hot_max_abs_without",
      "marked_spans",
      "n_legs_without"
     ],
     "properties": {
      "marked_spans": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "n_legs_without": {
       "type": "integer"
      },
      "coefficients_without": {
       "type": [
        "object",
        "null"
       ],
       "additionalProperties": {
        "type": "number"
       }
      },
      "lodo_hot_max_abs_without": {
       "type": [
        "number",
        "null"
       ]
      }
     }
    },
    "model_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "qualified": {
     "enum": [
      "yes",
      "no",
      "not_run"
     ]
    },
    "trace_coverage": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "min",
      "n_legs_under_0_99"
     ],
     "properties": {
      "min": {
       "type": "number"
      },
      "n_legs_under_0_99": {
       "type": "integer"
      }
     },
     "description": "Mythos cold seat 9: the minimum over energy-fit legs of the channel's per-segment covered fraction, and the count of legs under 0.99. Printed; decides nothing. A new print, pending the research lead's ruling"
    },
    "fold_coefficients": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "description": "RL-166b P-1: each LODO fold's coefficient vector, by held-out day and column name"
    },
    "day_detail": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "days",
      "s_no_heat",
      "s_with_heat"
     ],
     "properties": {
      "days": {
       "type": "object",
       "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "hot_blocks",
         "legs_with_hot_block",
         "se_no_heat",
         "se_with_heat"
        ],
        "properties": {
         "legs_with_hot_block": {
          "type": "integer"
         },
         "hot_blocks": {
          "type": "integer"
         },
         "se_with_heat": {
          "type": [
           "number",
           "null"
          ]
         },
         "se_no_heat": {
          "type": [
           "number",
           "null"
          ]
         }
        }
       }
      },
      "s_with_heat": {
       "type": [
        "number",
        "null"
       ]
      },
      "s_no_heat": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "description": "RL-166b P-2: per counted day, legs with a hot block, hot blocks and s/sqrt(n) with and without the heat columns; s is the SD of per-leg signed hot-stretch errors within days, pooled over counted days. No rule reads it"
    },
    "onset_offset_residuals": {
