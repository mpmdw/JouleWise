{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "joulewise.cadence_look_output.interim.v1",
  "title": "Interim look output (lm-interim-01): the only file the analyst seat writes from campaign energy",
  "description": "DRAFT, part of freeze 1 (RL-149 section 2.6 item 1, RL-150 R4). The lead checks the look's output against this schema before anyone else reads it (RL-149 section 2.6). Closed at every level. No per-leg joule, watt or energy value appears; fits, errors and ratios only (manifest energy.per_leg_energy_in_output false, open question Q16). Every print carries model_sha256 and qualified (RL-149 section 4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "look_id", "manifest_sha256", "code_sha256", "roster", "inclusion_table", "channels", "step3_statistic_iii", "qualified_interim_half", "realized_prompt_tokens", "decisions", "disclosure"],
  "properties": {
    "schema": {"const": "joulewise.cadence_look_output.interim.v1"},
    "look_id": {"const": "lm-interim-01"},
    "manifest_sha256": {"$ref": "#/$defs/sha"},
    "code_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha"}, "minProperties": 1},
    "roster": {
      "type": "object", "additionalProperties": false, "required": ["spans", "fit_days", "ledger_sha256"],
      "properties": {
        "spans": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["span_id", "block_id", "role", "t0_local_date"],
          "properties": {"span_id": {"type": "string"}, "block_id": {"type": "string"},
            "role": {"enum": ["fit", "describe"]}, "t0_local_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}}},
        "fit_days": {"type": "integer", "minimum": 3},
        "ledger_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "inclusion_table": {
      "description": "Per leg, the six rules' verdicts. Reads no energy (RL-157 section 4). Printed for every leg the roster names, included or not (RL-149 section 2.4: every attempt stays in custody).",
      "type": "array",
      "items": {"type": "object", "additionalProperties": false,
        "required": ["span_id", "leg_id", "block_id", "g0_role", "rules", "included", "marks"],
        "properties": {
          "span_id": {"type": "string"}, "leg_id": {"type": "string", "pattern": "^[LH]\\d{3}$"},
          "block_id": {"type": "string"}, "g0_role": {"enum": ["own", "capture", "consumer", null]},
          "rules": {"type": "object", "additionalProperties": false,
            "required": ["ran_to_cap", "g0_released", "sidecar_coverage", "km003c_clean", "not_a_contaminated_attempt", "block_power_mode"],
            "properties": {
              "ran_to_cap": {"type": "boolean"}, "g0_released": {"type": "boolean"},
              "sidecar_coverage": {"type": "boolean"}, "km003c_clean": {"type": "boolean"},
              "not_a_contaminated_attempt": {"type": "boolean"}, "block_power_mode": {"type": "boolean"}}},
          "included": {"type": "boolean"},
          "marks": {"type": "array", "items": {"enum": ["reference from a redo", "reference from an excluded leg"]}}
        }}
    },
    "channels": {
      "description": "The same prints on each channel: gpu_rail and dc_in (RL-149 section 2.6, 'the same for DC-in').",
      "type": "object", "additionalProperties": false, "required": ["gpu_rail", "dc_in"],
      "properties": {"gpu_rail": {"$ref": "#/$defs/channel"}, "dc_in": {"$ref": "#/$defs/channel"}}
    },
    "step3_statistic_iii": {
      "description": "Step 3's statistic (iii), pre-cut drift, on the development legs, by the frozen step 3 code (RL-151 section 1.3 item 2). A percentage, not an energy.",
      "type": "object", "additionalProperties": false, "required": ["value_pct", "legs", "threshold_pct", "trips", "form_print"],
      "properties": {"value_pct": {"type": "number"}, "legs": {"type": "integer"}, "threshold_pct": {"type": "number"},
        "trips": {"type": "boolean"},
        "form_print": {"description": "Step 4's caveat (evidence step4-rl151-drift.md): the drift's form, as per-block ratios to blocks 1-3, when (iii) is well above 2 %. Ratios only.",
          "type": ["array", "null"], "items": {"type": "number"}},
        "model_sha256": {"$ref": "#/$defs/sha"}, "qualified": {"$ref": "#/$defs/qualified"}}
    },
    "qualified_interim_half": {
      "description": "RL-151 section 2.1: qualified is yes when the interim look's leave-one-day-out error over the hot stretch is at or under 2 % AND the qualification bias at 1.10 has its 90 % interval inside +/-0.10. This look computes the first half only.",
      "type": "object", "additionalProperties": false, "required": ["lodo_hot_stretch_rel_error", "threshold", "passes"],
      "properties": {"lodo_hot_stretch_rel_error": {"type": "number"}, "threshold": {"const": 0.02}, "passes": {"type": "boolean"}}
    },
    "realized_prompt_tokens": {
      "description": "RL-158 Q5: legs whose realized prompt count is more than 5 % from nominal. Counts only.",
      "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["span_id", "leg_id", "nominal", "realized"],
        "properties": {"span_id": {"type": "string"}, "leg_id": {"type": "string"}, "nominal": {"type": "integer"}, "realized": {"type": "integer"}}}
    },
    "decisions": {
      "type": "object", "additionalProperties": false, "required": ["drift_tripwire", "qualified_interim_half", "hp01_included_below_9", "extension_rule"],
      "properties": {
        "drift_tripwire": {"enum": ["within", "to the research lead"]},
        "qualified_interim_half": {"enum": ["passes", "fails"]},
        "hp01_included_below_9": {"enum": ["no", "yes: reported before the look", "hp-01 not yet desk-final"]},
        "extension_rule": {"enum": ["none written; any extension needs a ruling"]}
      }
    },
    "disclosure": {
      "description": "The blind statement's entry for this look (RL-149 section 2.6, as worded by RL-150 R6): date, code hash, output hash.",
      "type": "object", "additionalProperties": false, "required": ["date", "code_sha256", "analyst_seat", "statement"],
      "properties": {"date": {"type": "string"}, "code_sha256": {"$ref": "#/$defs/sha"}, "analyst_seat": {"type": "string"},
        "statement": {"type": "string"}}
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualified": {"enum": ["yes", "no", "not_run"]},
    "lodo": {"type": "object", "additionalProperties": false, "required": ["per_day", "median", "max", "days"],
      "properties": {"per_day": {"type": "object", "additionalProperties": {"type": "number"}},
        "median": {"type": "number"}, "max": {"type": "number"}, "days": {"type": "integer", "minimum": 3}}},
    "carries": {"type": "object", "additionalProperties": false, "required": ["model_sha256", "qualified"],
      "properties": {"model_sha256": {"$ref": "#/$defs/sha"}, "qualified": {"$ref": "#/$defs/qualified"}}},
    "channel": {
      "type": "object", "additionalProperties": false,
      "required": ["heat_term_fit", "lodo_rel_error_hot_stretch", "lodo_rel_error_leg", "prefix_length_bias", "onset_fit", "onset_lodo_error", "high_power_table", "marked_span_sensitivity"],
      "properties": {
        "heat_term_fit": {"type": "object", "additionalProperties": false, "required": ["predictors", "coefficients", "covariance", "n_legs", "n_days", "carries"],
          "properties": {"predictors": {"type": "array", "items": {"type": "string"}},
            "coefficients": {"type": "object", "additionalProperties": {"type": "number"}},
            "covariance": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
            "n_legs": {"type": "integer"}, "n_days": {"type": "integer"}, "carries": {"$ref": "#/$defs/carries"}}},
        "lodo_rel_error_hot_stretch": {"allOf": [{"$ref": "#/$defs/lodo"}]},
        "lodo_rel_error_leg": {"allOf": [{"$ref": "#/$defs/lodo"}]},
        "prefix_length_bias": {"type": "object", "additionalProperties": false, "required": ["1.10", "1.30", "1.374", "unit", "carries"],
          "properties": {"1.10": {"$ref": "#/$defs/bias"}, "1.30": {"$ref": "#/$defs/bias"}, "1.374": {"$ref": "#/$defs/bias"},
            "unit": {"const": "score_sd"}, "carries": {"$ref": "#/$defs/carries"}}},
        "onset_fit": {"type": "object", "additionalProperties": false, "required": ["predictors", "coefficients", "censored_legs", "carries"],
          "properties": {"predictors": {"type": "array", "items": {"type": "string"}},
            "coefficients": {"type": "object", "additionalProperties": {"type": "number"}},
            "censored_legs": {"type": "integer"}, "carries": {"$ref": "#/$defs/carries"}}},
        "onset_lodo_error": {"type": "object", "additionalProperties": false, "required": ["seconds_per_day", "median_s", "max_s"],
          "properties": {"seconds_per_day": {"type": "object", "additionalProperties": {"type": "number"}}, "median_s": {"type": "number"}, "max_s": {"type": "number"}}},
        "high_power_table": {
          "description": "RL-149 section 2.5 and RL-157: onset, clock, share of decode scored and energy RATIOS against Automatic at matched cell, soak and span position; the Automatic block-to-block spread beside each ratio; included count per row; cold starts marked by the measured start reading; caption 'soak in Automatic; mode set N s before the first leg's G0'. Description only, never in the fit. null when hp-01 is not desk-final at the look (Q9).",
          "type": ["object", "null"], "additionalProperties": false, "required": ["caption", "rows"],
          "properties": {"caption": {"type": "string"},
            "rows": {"type": "array", "items": {"type": "object", "additionalProperties": false,
              "required": ["cell", "span_position", "included_h", "included_automatic", "onset_s_ratio", "clock_ratio", "share_scored_ratio", "energy_ratio", "automatic_spread"],
              "properties": {"cell": {"type": "integer"}, "span_position": {"enum": ["cold", "warm"]},
                "included_h": {"type": "integer"}, "included_automatic": {"type": "integer"},
                "onset_s_ratio": {"type": ["number", "null"]}, "clock_ratio": {"type": ["number", "null"]},
                "share_scored_ratio": {"type": ["number", "null"]}, "energy_ratio": {"type": ["number", "null"]},
                "automatic_spread": {"type": ["number", "null"]}}}}}},
        "marked_span_sensitivity": {
          "description": "RL-161 section 4: the fit's result with and without spans marked 'reference from an excluded leg' (and, per Q20, 'reference from a redo').",
          "type": "object", "additionalProperties": false, "required": ["marked_spans", "lodo_hot_stretch_without"],
          "properties": {"marked_spans": {"type": "array", "items": {"type": "string"}},
            "lodo_hot_stretch_without": {"type": ["number", "null"]}}}
      }
    },
    "bias": {"type": "object", "additionalProperties": false, "required": ["estimate", "ci90"],
      "properties": {"estimate": {"type": "number"}, "ci90": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}}
  }
}
