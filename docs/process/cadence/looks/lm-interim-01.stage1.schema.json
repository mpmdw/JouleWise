{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "joulewise.cadence_look_stage1.v1",
 "title": "Interim look, stage 1 output, level D (lm-interim-01): no energy",
 "description": "DRAFT, part of freeze 1 (RL-166 Q8; RL-166 Amends). Level D of the analyst seat's data interface (docs/process/cadence_look_fit_interface.md section 3, PR #795), transcribed field for field. Committed with its sha256 before stage 2 opens a file; stage 2 takes it by that hash. Closed at every level; it carries no energy, power or meter value. The rules-3/4 verdicts enter through inclusion_34.py's verdict file, hashed into code_sha256's inputs by the CLI.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "active_readings",
  "allow_draft",
  "calibrated_range",
  "centring",
  "code_sha256",
  "counts",
  "input_sha256",
  "legs",
  "look_id",
  "manifest_sha256",
  "meter_clock",
  "numpy_version",
  "onset",
  "onsets_before_116_s",
  "rates",
  "roster",
  "schema",
  "synthetic",
  "tripwires"
 ],
