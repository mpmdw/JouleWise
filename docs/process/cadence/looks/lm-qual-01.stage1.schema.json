{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lm-qual-01 qualification stage 1",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "span": {
      "type": "string",
      "pattern": "^qual-0[1-3]-s0[12]$"
    },
    "legKey": {
      "type": "string",
      "pattern": "^qual-0[1-3]-s0[12]/[AL][0-9]{3}$"
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leg_key",
        "span_id",
        "leg_type",
        "P",
        "N",
        "pair",
        "order",
        "maintenance_job",
        "rules",
        "segments",
        "prefixes",
        "terminal"
      ],
      "properties": {
        "leg_key": {
          "$ref": "#/$defs/legKey"
        },
        "span_id": {
          "$ref": "#/$defs/span"
        },
        "leg_type": {
          "enum": [
            "A",
            "L"
          ]
        },
        "P": {
          "enum": [
            2000,
            10000,
            19458
          ]
        },
        "N": {
          "enum": [
            3151,
            3724,
            4096
          ]
        },
        "pair": {
          "type": [
            "string",
            "null"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "maintenance_job": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ran_to_cap",
            "g0_released",
            "sidecar_coverage",
            "km003c_clean",
            "not_a_contaminated_attempt",
            "block_power_mode"
          ],
          "properties": {
            "ran_to_cap": {
              "type": "boolean"
            },
            "g0_released": {
              "type": "boolean"
            },
            "sidecar_coverage": {
              "type": "boolean"
            },
            "km003c_clean": {
              "type": "boolean"
            },
            "not_a_contaminated_attempt": {
              "type": "boolean"
            },
            "block_power_mode": {
              "type": "boolean"
            }
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "prefixes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "terminal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/terminal"
            }
          ]
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_lo",
        "edge_hi",
        "gaps"
      ],
      "properties": {
        "edge_lo": {
          "type": "integer",
          "minimum": 0
        },
        "edge_hi": {
          "type": "integer",
          "minimum": 0
        },
        "gaps": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_id",
        "pair_id",
        "ratio",
        "full",
        "short",
        "full_first",
        "included"
      ],
      "properties": {
        "span_id": {
          "$ref": "#/$defs/span"
        },
        "pair_id": {
          "type": "string"
        },
        "ratio": {
          "enum": [
            "1.10",
            "1.30"
          ]
        },
        "full": {
          "$ref": "#/$defs/legKey"
        },
        "short": {
          "$ref": "#/$defs/legKey"
        },
        "full_first": {
          "type": "boolean"
        },
        "included": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/legKey"
          },
          "uniqueItems": true,
          "maxItems": 2
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_lo",
        "edge_hi",
        "gaps",
        "context_tokens"
      ],
      "properties": {
        "edge_lo": {
          "type": "integer",
          "minimum": 0
        },
        "edge_hi": {
          "type": "integer",
          "minimum": 0
        },
        "gaps": {
          "type": "integer",
          "minimum": 0
        },
        "context_tokens": {
          "type": "number",
          "minimum": 1
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "look_id",
    "registration_commit",
    "registration_sha256",
    "manifest_sha256",
    "input_sha256",
    "numpy_version",
    "configs",
    "dates",
    "roster",
    "pairs",
    "counts",
    "singletons",
    "joint"
  ],
  "properties": {
    "schema": {
      "const": "joulewise.cadence_looks.qual_stage1.v1"
    },
    "look_id": {
      "const": "lm-qual-01"
    },
    "registration_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "registration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "numpy_version": {
      "type": "string",
      "minLength": 1
    },
    "configs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development_sha256",
        "qualification_sha256"
      ],
      "properties": {
        "development_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "qualification_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "dates": {
      "type": "object",
      "minProperties": 6,
      "propertyNames": {
        "$ref": "#/$defs/span"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    "roster": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/leg"
      },
      "minItems": 36,
      "maxItems": 36
    },
    "pairs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pair"
      },
      "minItems": 6,
      "maxItems": 6
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_legs",
        "by_cell",
        "by_job",
        "by_ratio"
      ],
      "properties": {
        "included_legs": {
          "type": "integer",
          "minimum": 0
        },
        "by_cell": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_job": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_ratio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "1.10",
            "1.30"
          ],
          "properties": {
            "1.10": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "complete",
                "incomplete",
                "complete_ids",
                "incomplete_ids"
              ],
              "properties": {
                "complete": {
                  "type": "integer",
                  "minimum": 0
                },
                "incomplete": {
                  "type": "integer",
                  "minimum": 0
                },
                "complete_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "incomplete_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              }
            },
            "1.30": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "complete",
                "incomplete",
                "complete_ids",
                "incomplete_ids"
              ],
              "properties": {
                "complete": {
                  "type": "integer",
                  "minimum": 0
                },
                "incomplete": {
                  "type": "integer",
                  "minimum": 0
                },
                "complete_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "incomplete_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    },
    "singletons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legKey"
      },
      "uniqueItems": true
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "1/full_first",
        "1/short_first",
        "2/full_first",
        "2/short_first"
      ],
      "properties": {
        "1/full_first": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "1/short_first": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "2/full_first": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "2/short_first": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
