{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JouleWise MBP rule register",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "class": {
        "enum": [
          "PHYSICS",
          "SAFETY",
          "VALIDITY"
        ]
      },
      "protects": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "test": {
        "anyOf": [
          {
            "enum": [
              "host_power",
              "host_disk",
              "host_meter",
              "host_clean",
              "host_quiet",
              "owner_stop",
              "copy_debt",
              "pin",
              "window",
              "dependency",
              "fits",
              "launcher_admits",
              "not_refused",
              "session_route",
              "batch_clear",
              "desk_gate",
              "contaminated_redos",
              "new_pin_smoke",
              "f0_retirement",
              "ready_outside_block",
              "hygiene",
              "filler_ladder"
            ]
          },
          {
            "type": "string",
            "pattern": "^pipeline:.+"
          }
        ]
      },
      "scope": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "owner": {
        "enum": [
          "lead",
          "research_lead"
        ]
      },
      "added": {
        "type": "string",
        "format": "date",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "review_by": {
        "anyOf": [
          {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          {
            "type": "string",
            "pattern": "^end:\\S.*$"
          }
        ]
      },
      "status": {
        "enum": [
          "LIVE",
          "FLAG",
          "RETIRED"
        ]
      },
      "params": {
        "type": "object"
      }
    },
    "required": [
      "id",
      "class",
      "protects",
      "test",
      "scope",
      "source",
      "owner",
      "added",
      "review_by",
      "status"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "test": {
              "const": "host_disk"
            }
          }
        },
        "then": {
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "floor_gib": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "floor_gib"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "params"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "test": {
              "const": "host_quiet"
            }
          }
        },
        "then": {
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "patterns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "recheck_s": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "patterns",
                "recheck_s"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "params"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "test": {
              "const": "owner_stop"
            }
          }
        },
        "then": {
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "maintenance_marker": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "recheck_s": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "test": {
              "const": "copy_debt"
            }
          }
        },
        "then": {
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "wait_s": {
                  "type": "integer",
                  "minimum": 0
                },
                "page_age_s": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "wait_s"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "params"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "test": {
              "const": "launcher_admits"
            }
          }
        },
        "then": {
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "output_root": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "test": {
              "const": "batch_clear"
            }
          }
        },
        "then": {
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "offset_s": {
                  "type": "integer",
                  "minimum": 0
                },
                "period_s": {
                  "type": "integer",
                  "minimum": 1
                },
                "settle_s": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "offset_s",
                "period_s",
                "settle_s"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "params"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "test": {
              "const": "f0_retirement"
            }
          }
        },
        "then": {
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "gate": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                }
              },
              "required": [
                "gate"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "params"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "test": {
              "const": "filler_ladder"
            }
          }
        },
        "then": {
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "stability_prefix": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "instrument_prefix": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "high_power_prefix": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "high_power_look_gate": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                }
              },
              "required": [
                "stability_prefix",
                "instrument_prefix",
                "high_power_prefix",
                "high_power_look_gate"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "params"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "test": {
              "const": "hygiene"
            }
          }
        },
        "then": {
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "start_gate": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "end_gate": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                }
              },
              "required": [
                "start_gate",
                "end_gate"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "params"
          ]
        }
      }
    ]
  }
}
