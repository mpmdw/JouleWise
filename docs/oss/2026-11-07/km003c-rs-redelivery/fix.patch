+/// behind the last accepted one. It is rejected without counting toward
+/// [`MAX_CONSECUTIVE_REJECTED_SAMPLES`]; otherwise a re-delivered run longer
+/// than that threshold restarted continuity, and its remainder was
+/// integrated a second time.
+const MAX_REDELIVERED_SAMPLES: u16 = 64;
