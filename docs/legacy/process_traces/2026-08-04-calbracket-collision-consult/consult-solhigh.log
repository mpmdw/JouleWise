   732	    artifacts = dict(artifact_sha256 or {})
   733	    content_id = content_id_from_artifact_hashes(artifacts)
   734	
   735	    def build(receipts: Sequence[Mapping[str, Any]]) -> Mapping[str, Any]:
   736	        reservations = [
   737	            row
   738	            for row in receipts
   739	            if row["attempt_id"] == attempt_id and row["event"] == "reservation"
   740	        ]
   741	        finals = [
   742	            row
   743	            for row in receipts
   744	            if row["attempt_id"] == attempt_id and row["event"] == "finalization"
   745	        ]
   746	        if len(reservations) != 1 or finals:
   747	            raise CalibrationLedgerError("attempt is not uniquely pending")
