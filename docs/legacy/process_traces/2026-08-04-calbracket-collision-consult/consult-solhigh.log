             for block in blocks:
                 block_members = (
                     block.get("members") if isinstance(block, Mapping) else None
                 )
                 if isinstance(block_members, Mapping):
                     ids.extend(
                         block_members[position]
                         for position in _ABBA_POSITIONS
                         if isinstance(block_members.get(position), str)
                     )
     return ids
 
 
