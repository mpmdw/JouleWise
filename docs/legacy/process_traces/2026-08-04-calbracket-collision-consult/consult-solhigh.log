         if not isinstance(cell, Mapping):
             continue
         members = cell.get("members")
         if isinstance(members, list):
             ids.extend(
                 row["bundle_id"]
                 for row in members
                 if isinstance(row, Mapping) and isinstance(row.get("bundle_id"), str)
