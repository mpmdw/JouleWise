   216	def _finite(value: object, label: str, *, nonnegative: bool = False) -> float:
   217	    if isinstance(value, bool) or not isinstance(value, int | float):
   218	        raise MintError(f"{label} must be a finite number")
   219	    converted = float(value)
   220	    if not math.isfinite(converted) or (nonnegative and converted < 0.0):
   221	        raise MintError(f"{label} must be a finite nonnegative number")
   222	    return converted
