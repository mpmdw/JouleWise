   754	            dict(reservation["identity_epoch"]) != normalized_epoch
   755	            or dict(reservation["t1_bindings"]) != normalized_t1
   756	            or reservation["custody_locator"] != custody_locator
   757	        ):
   758	            raise CalibrationLedgerError(
   759	                "finalization conflicts with the reserved attempt binding"
   760	            )
   761	        predecessor = receipts[-1]["receipt_digest"] if receipts else GENESIS_DIGEST
   762	        return _new_receipt(
   763	            sequence=len(receipts) + 1,
   764	            predecessor_digest=str(predecessor),
   765	            event="finalization",
   766	            attempt_id=attempt_id,
   767	            content_id=content_id,
   768	            artifacts=artifacts,
   769	            identity_epoch=identity_epoch,
   770	            t1_bindings=t1_bindings,

