{
  "name": "anchor-tag-creation-admins-only",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/b5/**",
        "refs/tags/b6/**",
        "refs/tags/bytes/**",
        "refs/tags/pin/**",
        "refs/tags/archive/**"
      ],
      "exclude": []
    }
  },
  "rules": [
    { "type": "creation" }
  ]
}
