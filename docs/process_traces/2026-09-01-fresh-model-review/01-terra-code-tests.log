   622	                f"block {index} zero point diverges from its block delta "
   623	                "outside the registered provenance band",
   624	            )
   625	        envelope_sum = _common_mode_finite(raw_envelope_sum)
   626	        if envelope_sum is None or envelope_sum < 0.0:
   627	            _common_mode_refuse(
   628	                "common_mode_precondition_failed",
   629	                f"block {index} member envelope integral sum must be finite "
   630	                "and nonnegative",
   631	            )
   632	        block_widths.append(
   633	            _common_mode_block_half_width(
   634	                deltas[index],
   635	                onset,
   636	                offset,
   637	                zero_point,
   638	                envelope_sum,
   639	                residuals,
   640	            )
   641	        )
   642	
   643	    return comparative_false_effect_floor(
   644	        deltas,
   645	        admissible_half_widths_j=block_widths,
