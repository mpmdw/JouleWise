   675	def _clean_values(values_j: Sequence[float], label: str) -> list:
   676	    cleaned = []
   677	    for value in values_j:
   678	        if isinstance(value, bool) or not isinstance(value, (int, float)):
   679	            raise TypeError(f"{label} must be finite numbers")
   680	        value = float(value)
   681	        if not math.isfinite(value):
   682	            raise ValueError(f"{label} must be finite")
   683	        cleaned.append(value)
   684	    if len(cleaned) < 2:
   685	        raise ValueError(f"need at least 2 {label} for a sample standard deviation")
   686	    return cleaned
