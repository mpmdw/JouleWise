   514	    def acknowledge_custody(
   515	        self,
   516	        acknowledgement: DurableCustodyAcknowledgement,
   517	    ) -> list[dict[str, Any]]:
   518	        """Release retained remote artifacts only after durable token proof."""
   519	
   520	        with self._retention_manifest_lock():
   521	            records = self._load_retention_records()
   522	            record = next(
   523	                (item for item in records if item.get("token") == acknowledgement.token),
   524	                None,
   525	            )
   526	            if record is None:
   527	                return []
   528	            if not self._acknowledgement_is_valid(acknowledgement, record):
   529	                raise ValueError("custody acknowledgement does not match retained task")
   530	            record["acknowledgement_path"] = str(acknowledgement.acknowledgement_path)
   531	            record["acknowledged"] = True
   532	            self._write_retention_records(records)
   533	            return self._cleanup_retention_record(record, records)
   534	
   535	    def _new_retention_record(
   536	        self,
   537	        *,
   538	        token: str,
   539	        task_id: str,
   540	        run_id: str,
   541	        prepared_task: dict[str, Any],
   542	        paths: dict[str, str],
   543	        remote_task_path: str,
   544	        remote_artifacts_path: str,
   545	        context: RunContext | None,
   546	    ) -> dict[str, Any]:
   547	        if context is None:
   548	            bundle_path = self.retention_root / "standalone" / token
   549	            custody_path = bundle_path / "raw" / "node-custody"
   550	        else:
   551	            bundle_path = context.bundle_path
   552	            custody_path = context.raw_dir / ".node-custody" / token
   553	        return {
   554	            "token": token,
   555	            "correlation_token": prepared_task.get("correlation_token"),
   556	            "protocol_version": prepared_task.get("protocol_version"),
   557	            "scope": self._retention_scope(),
   558	            "task_id": task_id,
   559	            "run_id": run_id,
   560	            "task_type": prepared_task.get("task_type"),
   561	            "operation": prepared_task.get("operation"),
   562	            "node_role": prepared_task.get("node_role"),
   563	            "run_dir": paths["run_dir"],
   564	            "remote_artifacts_path": remote_artifacts_path,
