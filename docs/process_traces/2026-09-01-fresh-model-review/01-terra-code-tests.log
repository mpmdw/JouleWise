    30	
    31	def _strict_object_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    32	    value: dict[str, Any] = {}
    33	    for key, item in pairs:
    34	        if key in value:
    35	            raise SummaryError("duplicate_key")
    36	        value[key] = item
    37	    return value
    38	
    39	
    40	def _rule() -> dict[str, Any]:
    41	    return {
    42	        "all_small_count_ge_5_required": True,
    43	        "ladder_prefill_tokens": list(LADDER),
    44	        "minimum_overlapping_power_interval_count": (
    45	            MIN_OVERLAPPING_POWER_INTERVAL_COUNT
    46	        ),
    47	        "minimum_small_members_per_rung": MIN_SMALL_MEMBERS,
    48	        "reducer_min_phase_samples": REDUCER_MIN_PHASE_SAMPLES,
    49	        "selection": "shortest_qualifying_rung",
    50	    }
    51	
    52	
    53	def _normalized_rows(value: Any) -> list[dict[str, Any]]:
    54	    if not isinstance(value, list) or len(value) != len(LADDER):
    55	        raise SummaryError("expected_four_row_array")
    56	    rows: list[dict[str, Any]] = []
    57	    for item in value:
    58	        if not isinstance(item, dict):
    59	            raise SummaryError("row_not_object")
    60	        length = item.get("length")
    61	        small_members = item.get("small_members")
    62	        all_small = item.get("all_small_count_ge_5")
    63	        if isinstance(length, bool) or not isinstance(length, int):
    64	            raise SummaryError("length_not_integer")
    65	        if isinstance(small_members, bool) or not isinstance(small_members, int):
    66	            raise SummaryError("small_members_not_integer")
    67	        if not isinstance(all_small, bool):
    68	            raise SummaryError("all_small_count_ge_5_not_boolean")
    69	        minimum = item.get("small_minimum_count")
    70	        if small_members > 0:
    71	            if isinstance(minimum, bool) or not isinstance(minimum, int):
    72	                raise SummaryError("small_minimum_count_not_integer")
    73	            # The summary's derived fields must agree with each other; a
    74	            # contradictory record never authorizes a selection.
    75	            if all_small != (
    76	                minimum >= MIN_OVERLAPPING_POWER_INTERVAL_COUNT
    77	            ):
    78	                raise SummaryError("summary_internally_contradictory")
    79	        else:
    80	            if minimum is not None:
    81	                raise SummaryError("summary_internally_contradictory")
    82	            if all_small:
    83	                raise SummaryError("summary_internally_contradictory")
    84	        rows.append(
    85	            {
    86	                "all_small_count_ge_5": all_small,
    87	                "length": length,
    88	                "small_members": small_members,
    89	                "small_minimum_count": minimum,
    90	            }
    91	        )
    92	    rows.sort(key=lambda row: row["length"])
    93	    if tuple(row["length"] for row in rows) != LADDER:
    94	        raise SummaryError("ladder_mismatch_or_duplicate")
    95	    return rows
    96	
    97	
    98	def select(summary: Any, *, summary_sha256: str) -> dict[str, Any]:
    99	    if REDUCER_MIN_PHASE_SAMPLES != PREREGISTERED_MIN_PHASE_SAMPLES:
   100	        raise SummaryError("reducer_floor_drift")
   101	    rows = _normalized_rows(summary)
   102	    qualifying = [
   103	        row["length"]
   104	        for row in rows
   105	        if row["small_members"] >= MIN_SMALL_MEMBERS
   106	        and row["all_small_count_ge_5"]
   107	    ]
   108	    selected = qualifying[0] if qualifying else None
   109	    record: dict[str, Any] = {
   110	        "collection_prefill_tokens": selected if selected is not None else 4096,
   111	        "qualifying_prefill_tokens": qualifying,
   112	        "refusal": None,
   113	        "rule": _rule(),
   114	        "schema_version": SCHEMA_VERSION,
   115	        "selected_prefill_tokens": selected,
   116	        "status": "selected" if selected is not None else "refused",
   117	        "summary_sha256": summary_sha256,
   118	    }
   119	    if selected is None:
   120	        record["refusal"] = {
   121	            "code": "no_g2a_prefill_rung_qualifies",
   122	            "fallback_action": "collect_at_4096",
   123	            "fallback_label": "collect-at-4096",
   124	            "result_reporting": {
   125	                "count_below_reducer_minimum": {
   126	                    "count_range": "<3",
   127	                    "refusal": "not_resolvable_sample_count",
   128	                },
   129	                "count_below_pre_registered_floor": {
   130	                    "count_range": "3-4",
   131	                    "disclose_reducer_resolvable_result": True,
   132	                    "refusal": "below the pre-registered count floor of 5",
   133	                },
   134	            },
   135	        }
   136	    return record
   137	
   138	
   139	def _malformed_record(*, summary_sha256: str | None, reason: str) -> dict[str, Any]:
   140	    return {
   141	        "collection_prefill_tokens": None,
   142	        "qualifying_prefill_tokens": [],
   143	        "refusal": {
   144	            "code": "malformed_g2a_prefill_summary",
   145	            "reason": reason,
   146	        },
   147	        "rule": _rule(),
   148	        "schema_version": SCHEMA_VERSION,
   149	        "selected_prefill_tokens": None,
   150	        "status": "refused",
   151	        "summary_sha256": summary_sha256,
   152	    }
   153	
   154	
   155	def _write_record(path: Path, record: dict[str, Any]) -> None:
   156	    path.write_text(
   157	        json.dumps(record, indent=2, sort_keys=True, ensure_ascii=True) + "\n",
   158	        encoding="utf-8",
   159	    )
   160	
   161	
   162	def build_parser() -> argparse.ArgumentParser:
   163	    parser = argparse.ArgumentParser(description=__doc__)
   164	    parser.add_argument("--summary", required=True, type=Path)
   165	    parser.add_argument("--output", required=True, type=Path)
   166	    return parser
   167	
   168	
   169	def main(argv: Sequence[str] | None = None) -> int:
   170	    args = build_parser().parse_args(argv)
   171	    raw: bytes | None = None
   172	    reason: str | None = None
   173	    try:
   174	        raw = args.summary.read_bytes()
   175	    except OSError:
   176	        reason = "input_unreadable"
   177	    summary_sha256 = hashlib.sha256(raw).hexdigest() if raw is not None else None
   178	    record: dict[str, Any]
   179	    if raw is None:
   180	        record = _malformed_record(summary_sha256=None, reason=str(reason))
   181	    else:
   182	        try:
   183	            summary = json.loads(raw, object_pairs_hook=_strict_object_pairs)
   184	            record = select(summary, summary_sha256=summary_sha256)
   185	        except (UnicodeDecodeError, json.JSONDecodeError):
   186	            reason = "invalid_json"
   187	            record = _malformed_record(
   188	                summary_sha256=summary_sha256, reason=reason
   189	            )
   190	        except SummaryError as exc:
   191	            reason = str(exc)
   192	            record = _malformed_record(
   193	                summary_sha256=summary_sha256, reason=reason
   194	            )
   195	    try:
   196	        _write_record(args.output, record)
   197	    except OSError as exc:
   198	        print(f"selection output unwritable: {exc}", file=sys.stderr)
   199	        return 2
   200	    return 2 if reason is not None else 0
   201	
   202	
   203	if __name__ == "__main__":
   204	    sys.dont_write_bytecode = True
   205	    raise SystemExit(main())
