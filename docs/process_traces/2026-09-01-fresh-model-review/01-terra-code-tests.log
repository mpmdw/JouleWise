  3282	def check(
  3283	    check_root: Path = REPO_ROOT,
  3284	    identity: GenerationIdentity | None = None,
  3285	) -> dict[str, str]:
  3286	    selected_identity = identity or GenerationIdentity()
  3287	    with tempfile.TemporaryDirectory(prefix="d117-gamma-check-") as temporary:
  3288	        temp_root = Path(temporary)
  3289	        hashes = generate(temp_root, selected_identity)
  3290	        generated = temp_root / selected_identity.pack_rel
  3291	        pack_root = check_root / selected_identity.pack_rel
  3292	        expected_paths = set(expected_pack_paths())
  3293	        generated_tree = json.loads(
  3294	            (generated / "plan_tree.json").read_text(encoding="utf-8")
  3295	        )
  3296	        freeze_reference = generated_tree["arm_attachments"]["arm_readiness"][
  3297	            "freeze_receipt"
  3298	        ]
  3299	        if freeze_reference is not None:
  3300	            freeze_path = Path(freeze_reference["path"])
  3301	            expected_paths |= {
  3302	                freeze_path,
  3303	                freeze_path.with_name(f"{freeze_path.name}.sha256"),
  3304	            }
  3305	            freeze_receipt = json.loads(
  3306	                (pack_root / freeze_path).read_text(encoding="utf-8")
  3307	            )
  3308	            for item in freeze_receipt["evidence"]:
  3309	                evidence_path = Path(item["path"])
  3310	                evidence_sidecar = (
  3311	                    evidence_path.with_suffix(".sha256")
  3312	                    if evidence_path.parent.name
  3313	                    == "identity_pin_projection.receipts"
  3314	                    else evidence_path.with_name(f"{evidence_path.name}.sha256")
  3315	                )
  3316	                expected_paths |= {evidence_path, evidence_sidecar}
  3317	                evidence_receipt = json.loads(
  3318	                    (pack_root / evidence_path).read_text(encoding="utf-8")
  3319	                )
  3320	                expected_paths.update(
  3321	                    Path(fact["source_path"])
  3322	                    for fact in evidence_receipt.get("facts", [])
  3323	                    if "source_path" in fact
  3324	                )
  3325	        projection_reference = generated_tree["arm_attachments"][
  3326	            "identity_pin_projection"
  3327	        ]["projection_receipt"]
  3328	        if projection_reference is not None:
  3329	            projection_path = Path(projection_reference["path"])
  3330	            expected_paths |= {
  3331	                projection_path,
  3332	                projection_path.with_suffix(".sha256"),
  3333	            }
  3334	        observed_paths = actual_pack_paths(pack_root)
  3335	        missing = sorted(expected_paths - observed_paths)
  3336	        extras = sorted(observed_paths - expected_paths)
  3337	        if missing or extras:
  3338	            detail: list[str] = []
  3339	            if missing:
  3340	                detail.append("missing=" + ",".join(path.as_posix() for path in missing))
  3341	            if extras:
  3342	                detail.append("extras=" + ",".join(path.as_posix() for path in extras))
  3343	            raise ValueError("pack inventory differs: " + "; ".join(detail))
  3344	        for relative in expected_pack_paths(include_generator=False):
  3345	            expected_path = generated / relative
  3346	            actual_path = pack_root / relative
  3347	            if not expected_path.is_file():
  3348	                raise ValueError(f"generated expected path missing: {relative}")
  3349	            if not actual_path.is_file():
  3350	                raise ValueError(f"production expected path missing: {relative}")
  3351	            if expected_path.read_bytes() != actual_path.read_bytes():
  3352	                raise ValueError(f"production bytes differ from regeneration: {relative}")
  3353	        # The generator is source input, not generated output. Its SHA is embedded in
  3354	        # plan_tree.json; comparing the repository path to itself would prove nothing.
  3355	        return hashes
