  2562	        contrast=contrast,
  2563	        onset_shifts_s=sorted(onset_candidates),
  2564	        offset_shifts_s=sorted(offset_candidates),
  2565	        bundle_residual_half_widths_j=residuals,
  2566	        member_window_bounds_s=[
  2567	            (
  2568	                by_position[position][1].start_s,
  2569	                by_position[position][1].end_s,
  2570	            )
  2571	            for position in _ABBA_POSITIONS
  2572	        ],
  2573	        member_envelope_integral_sum_j=member_envelope_integral_sum,
  2574	    )
