   284	def _successor_token(token: str, identity: GenerationIdentity) -> str:
   285	    if token == PACK_REL.name:
   286	        return identity.pack_id
   287	    current_version = CURRENT_FAMILY_SUFFIX.removeprefix("_")
   288	    version = identity.family_suffix.removeprefix("_")
   289	    hyphen_suffix = f"-{current_version}"
   290	    if token.endswith(hyphen_suffix):
   291	        return token[: -len(hyphen_suffix)] + f"-{version}"
   292	    if token.endswith(CURRENT_FAMILY_SUFFIX):
   293	        return token[: -len(CURRENT_FAMILY_SUFFIX)] + identity.family_suffix
   294	    raise ValueError(f"successor identity token has no version suffix: {token}")
   295	
   296	
   297	def thread_generation_identity(value: Any) -> Any:
   298	    identity = active_generation()
   299	    if identity.target_is_current:
   300	        return value
   301	    if isinstance(value, str):
   302	        for token in _SUCCESSOR_IDENTITY_TOKENS:
   303	            value = value.replace(token, _successor_token(token, identity))
   304	        return value
   305	    if isinstance(value, dict):
   306	        return {
   307	            thread_generation_identity(key): thread_generation_identity(item)
   308	            for key, item in value.items()
   309	        }
   310	    if isinstance(value, list):
   311	        return [thread_generation_identity(item) for item in value]
   312	    if isinstance(value, tuple):
   313	        return tuple(thread_generation_identity(item) for item in value)
   314	    return value
