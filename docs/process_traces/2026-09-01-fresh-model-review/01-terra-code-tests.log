  2382	def _common_mode_block_inputs_from_evidence(
  2383	    members: Sequence[MemberReport],
  2384	    *,
  2385	    runs_root: Path,
  2386	    metric: str,
  2387	    shared_edge_bound_s: float,
  2388	) -> _CommonModeBlockInputs:
  2389	    """Derive one D-124 arithmetic block from authenticated bundle evidence."""
  2390	
  2391	    prefix = "phase_energy_j."
  2392	    if not metric.startswith(prefix) or not metric[len(prefix) :]:
