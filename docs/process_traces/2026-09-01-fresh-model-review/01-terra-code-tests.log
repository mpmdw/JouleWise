   859	def _corner_maximized_unguarded_floor(
   860	    point_values_j: Sequence[float],
   861	    half_widths_j: Sequence[float],
   862	    *,
   863	    kind: str,
   864	) -> float:
   865	    """Return the exact full D-054 floor maximum over an interval box.
   866	
   867	    The maximum of the complete floor (maximum absolute term, sample
   868	    standard deviation, and Student-t prediction term) occurs at a vertex of
   869	    the independent member/delta interval box. Enumeration is deliberately
   870	    capped: callers must refuse rather than substitute an approximation once
   871	    the governed exact calculation is too large.
   872	    """
   873	
   874	    if len(point_values_j) != len(half_widths_j):
   875	        raise ValueError("admissible-set half-width count must match point estimates")
   876	    if not any(half_widths_j):
   877	        mean = sum(point_values_j) / len(point_values_j)
   878	        deviations = (
   879	            [value - mean for value in point_values_j]
   880	            if kind == "absolute"
   881	            else list(point_values_j)
   882	        )
   883	        prediction_extra = 0.0 if kind == "absolute" else abs(mean)
   884	        return _floor_estimate(
   885	            kind, deviations, mean, prediction_extra
   886	        ).unguarded_floor_j
   887	    if len(point_values_j) > MAX_EXACT_ADMISSIBLE_CORNER_N:
   888	        raise ValueError(
   889	            "exact admissible-set corner enumeration is capped at "
   890	            f"n={MAX_EXACT_ADMISSIBLE_CORNER_N}"
   891	        )
   892	
   893	    maximum = 0.0
   894	    for mask in range(1 << len(point_values_j)):
   895	        corner = [
   896	            point + (width if mask & (1 << index) else -width)
   897	            for index, (point, width) in enumerate(
   898	                zip(point_values_j, half_widths_j, strict=True)
   899	            )
   900	        ]
   901	        mean = sum(corner) / len(corner)
   902	        deviations = (
   903	            [value - mean for value in corner]
   904	            if kind == "absolute"
   905	            else corner
   906	        )
   907	        prediction_extra = 0.0 if kind == "absolute" else abs(mean)
   908	        maximum = max(
   909	            maximum,
   910	            _floor_estimate(
   911	                kind, deviations, mean, prediction_extra
   912	            ).unguarded_floor_j,
   913	        )
