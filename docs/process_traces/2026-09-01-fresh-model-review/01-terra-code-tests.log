   111	def freeze_aware_status(freeze_reference: object) -> str:
   112	    """Return future-pack status without rewriting the 2026-08-13 frozen bytes."""
   113	
   114	    if not isinstance(freeze_reference, dict):
   115	        return DRAFT_STATUS
   116	    if freeze_reference.get("sha256") == CURRENT_FROZEN_RECEIPT_SHA256:
   117	        return DRAFT_STATUS
   118	    return FROZEN_STATUS
