   273	@contextmanager
   274	def generation_context(identity: GenerationIdentity):
   275	    global _ACTIVE_GENERATION
   276	    previous = _ACTIVE_GENERATION
   277	    _ACTIVE_GENERATION = identity
   278	    try:
   279	        yield
   280	    finally:
   281	        _ACTIVE_GENERATION = previous
