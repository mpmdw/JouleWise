   508	def _common_mode_floor_from_extracted_inputs(
   509	    block_deltas_j: Sequence[float],
   510	    *,
   511	    onset_sweeps_j: Sequence[Sequence[float]],
   512	    offset_sweeps_j: Sequence[Sequence[float]],
   513	    zero_point_contrasts_j: Sequence[float],
   514	    bundle_residual_half_widths_j: Sequence[Sequence[float]],
   515	    member_window_bounds_s: object,
   516	    member_envelope_integral_sums_j: Sequence[float],
   517	    calibration_bracket: object,
   518	    shared_edge_bound_s: float,
   519	) -> FloorEstimate:
   520	    """Internal registered arithmetic seam fed by authenticated extraction."""
   521	
   522	    try:
   523	        deltas = _common_mode_clean_values(
   524	            block_deltas_j,
   525	            label="block deltas",
   526	        )
   527	        zero_points = _common_mode_clean_values(
   528	            zero_point_contrasts_j,
   529	            label="zero-point contrasts",
   530	        )
   531	        input_lengths_match = (
   532	            len(onset_sweeps_j)
   533	            == len(offset_sweeps_j)
   534	            == len(zero_points)
   535	            == len(bundle_residual_half_widths_j)
   536	            == len(member_envelope_integral_sums_j)
   537	            == len(deltas)
   538	        )
   539	    except (TypeError, ValueError) as exc:
   540	        _common_mode_refuse("common_mode_precondition_failed", str(exc))
   541	    if not input_lengths_match:
   542	        _common_mode_refuse(
   543	            "common_mode_precondition_failed",
   544	            "every extracted block needs onset, offset, a zero point, four "
   545	            "residuals, and a member envelope integral sum",
   546	        )
   547	
   548	    bound = _common_mode_finite(shared_edge_bound_s)
   549	    operative = registered_common_mode_operative_bound(calibration_bracket)
   550	    if (
   551	        bound is None
   552	        or bound <= 0.0
   553	        or not math.isclose(bound, operative, rel_tol=0.0, abs_tol=1e-12)
   554	    ):
   555	        _common_mode_refuse(
   556	            "common_mode_allowance_application_invalid",
   557	            "the sweep bound must equal the once-widened authenticated bound",
   558	        )
   559	    _common_mode_member_windows(
   560	        member_window_bounds_s,
   561	        expected_n=len(deltas),
   562	        bound=bound,
   563	    )
   564	
   565	    block_widths: list[float] = []
   566	    for index, (
   567	        raw_onset,
   568	        raw_offset,
   569	        zero_point,
   570	        raw_residuals,
   571	        raw_envelope_sum,
   572	    ) in enumerate(
   573	        zip(
   574	            onset_sweeps_j,
   575	            offset_sweeps_j,
   576	            zero_points,
   577	            bundle_residual_half_widths_j,
   578	            member_envelope_integral_sums_j,
   579	            strict=True,
   580	        )
   581	    ):
   582	        onset = _common_mode_clean_values(
   583	            raw_onset,
   584	            label=f"block {index} onset sweep",
   585	        )
   586	        offset = _common_mode_clean_values(
   587	            raw_offset,
   588	            label=f"block {index} offset sweep",
   589	        )
   590	        if zero_point not in onset or zero_point not in offset:
   591	            _common_mode_refuse(
   592	                "common_mode_precondition_failed",
   593	                f"block {index} sweeps must include the extracted zero point "
   594	                "by exact equality",
   595	            )
   596	        try:
   597	            residual_count = len(raw_residuals)
   598	        except TypeError:
   599	            residual_count = -1
   600	        if residual_count != 4:
   601	            _common_mode_refuse(
   602	                "common_mode_precondition_failed",
   603	                f"block {index} must have exactly four bundle residuals",
   604	            )
   605	        residuals: list[float] = []
   606	        for raw in raw_residuals:
   607	            residual = _common_mode_finite(raw)
   608	            if residual is None or residual < 0.0:
   609	                _common_mode_refuse(
   610	                    "common_mode_precondition_failed",
   611	                    f"block {index} residuals must be finite and nonnegative",
   612	                )
   613	            residuals.append(residual)
   614	        if not math.isclose(
   615	            zero_point,
   616	            deltas[index],
   617	            rel_tol=1e-9,
   618	            abs_tol=1e-12,
   619	        ):
