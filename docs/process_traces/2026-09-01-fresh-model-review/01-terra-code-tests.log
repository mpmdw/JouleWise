   121	def emitted_draft_status() -> str:
   122	    """Return the descriptive status byte written into generated artifacts.
   123	
   124	    This is deliberately NOT ``GenerationIdentity.target_status``. That
   125	    property is the dynamic, authenticated freeze state and remains the
   126	    authority a reader should consult; this function returns the generation-
   127	    time description that gets serialized into bytes the D-134 receipt pins.
   128	    Under the 2026-08-18 cold-gate verdict (holding 6) those bytes must never
   129	    transition, so the value they carry is freeze-neutral by construction and
   130	    ``FROZEN_STATUS`` is unreachable from every serialization site by design.
   131	    """
   132	
   133	    identity = active_generation()
   134	    if identity.target_is_successor_family:
   135	        return SUCCESSOR_EMITTED_STATUS
   136	    # Ordinal-1 packs were frozen on 2026-08-13 with this literal serialized;
   137	    # preserve-mode replay reproduces those committed bytes verbatim. In an
   138	    # EMITTED successor generator this branch is unreachable by design: its own
   139	    # family ordinal is >= 2 and the downgrade guard in GenerationIdentity
   140	    # refuses every target below it before any write.
   141	    return DRAFT_STATUS
   142	
