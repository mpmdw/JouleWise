  3274	def actual_pack_paths(pack_root: Path) -> set[Path]:
  3275	    return {
  3276	        path.relative_to(pack_root)
  3277	        for path in pack_root.rglob("*")
  3278	        if path.is_file() and "__pycache__" not in path.parts
  3279	    }
