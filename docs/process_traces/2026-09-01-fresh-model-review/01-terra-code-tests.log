   141	# option (d) as a gate condition -- holdings 1 and 6): the committed D-134
   142	# freeze receipt plus its plan-tree attachment IS the draft->frozen transition,
   143	# and the receipt's pack_identity pins calibration_plan.json -- which carries a
   144	# serialized status site -- by SHA. A post-mint serialized transition therefore
   145	# invalidates the receipt at the dry-run/arm/verify gates, and no re-mint path
   170	CURRENT_FROZEN_GENERATOR_SHA256 = ""
