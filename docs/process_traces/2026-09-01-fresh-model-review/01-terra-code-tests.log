   664	def small_sample_guard_factor(n: int) -> float:
   665	    """Frozen, accepted operational safety factor g(n) for n >= 5."""
   666	    if isinstance(n, bool) or not isinstance(n, int):
   667	        raise TypeError("n must be an int (bool rejected)")
   668	    if n < GUARD_MINIMUM_N:
   669	        raise ValueError(f"guard factor undefined below n={GUARD_MINIMUM_N} (smoke only)")
