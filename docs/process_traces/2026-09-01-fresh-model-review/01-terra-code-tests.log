   174	class GenerationIdentity:
   175	    def __init__(
   176	        self,
   177	        pack_id: str = PACK_REL.name,
   178	        family_suffix: str = CURRENT_FAMILY_SUFFIX,
   179	        preserve_current_frozen_bytes: bool = PRESERVE_CURRENT_FROZEN_BYTES,
   180	    ) -> None:
   181	        self.pack_id = pack_id
   182	        self.family_suffix = family_suffix
   183	        self.preserve_current_frozen_bytes = preserve_current_frozen_bytes
   184	        if not self.family_suffix.startswith("_v") or not self.family_suffix[2:].isdigit():
   185	            raise ValueError("family suffix must use the _v<positive integer> form")
   186	        if int(self.family_suffix[2:]) < 1:
   187	            raise ValueError("family suffix ordinal must be positive")
   188	        expected_pack_id = (
   189	            PACK_REL.name.removesuffix(CURRENT_FAMILY_SUFFIX) + self.family_suffix
   190	        )
   191	        if self.pack_id != expected_pack_id:
   192	            raise ValueError(
   193	                f"pack id must equal {expected_pack_id!r} for {self.family_suffix}"
   194	            )
   195	        # Downgrade guard (delta-7 F2). A generator whose own family ordinal is
   196	        # N must refuse every target below N, in EVERY mode -- generate,
   197	        # --check, preserve and no-preserve alike. Without it an emitted _v2
   198	        # generator accepts `--pack-id <family>_v1 --family-suffix _v1
   199	        # --no-preserve-current-frozen-bytes` and rewrites the predecessor's
   200	        # tracked, frozen plan_tree.json / plan_tree.sha256 /
   201	        # producer_contract.json: the ordinal-1 branches of every emitted_*
   202	        # helper are selected, so the rewrite is silent and byte-plausible.
   203	        # M-2's frozen-bytes-never-repaired doctrine bars that outright. This
   204	        # runs in the constructor, which every mode builds before it opens a
   205	        # single output path, so refusal is always pre-write. Same-ordinal
   206	        # (N -> N) draft/preserve behaviour and successor (N -> N+1)
   207	        # generation are untouched.
   208	        if self.target_ordinal < self.current_ordinal:
   209	            raise ValueError(
   210	                f"generator family ordinal {self.current_ordinal} refuses the "
   211	                f"downgrade target {self.pack_id!r} (family ordinal "
   212	                f"{self.target_ordinal}): an earlier family's committed bytes "
   213	                "are never rewritten by a later generator, in any mode"
   214	            )
   215	        if self.preserve_current_frozen_bytes and not self.target_is_current:
   216	            raise ValueError(
   217	                "preserve mode requires the current target identity"
   218	            )
   219	        if (
   220	            not self.preserve_current_frozen_bytes
   221	            and self.target_is_current
   222	            and (PRESERVE_CURRENT_FROZEN_BYTES or self.target_status == FROZEN_STATUS)
   223	        ):
   224	            raise ValueError("the current frozen identity requires preserve mode")
   225	
