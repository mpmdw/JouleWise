   689	def _floor_estimate(kind: str, deviations: Sequence[float], mean: float, prediction_extra: float) -> FloorEstimate:
   690	    n = len(deviations)
   691	    dev_mean = sum(deviations) / n
   692	    # math.fsum: the squared-residual reduction must be identical across
   693	    # supported interpreters (builtins.sum float summation changed in
   694	    # CPython 3.12); exact-golden fixtures pin this value bit-for-bit.
   695	    s = math.sqrt(math.fsum((d - dev_mean) ** 2 for d in deviations) / (n - 1))
   696	    t_critical = student_t_critical_95(n - 1)
   697	    prediction = prediction_extra + t_critical * s * math.sqrt(1.0 + 1.0 / n)
   698	    max_abs = max(abs(d) for d in deviations)
   699	    unguarded = max(max_abs, prediction)
   700	    if n >= GUARD_MINIMUM_N:
   701	        guard: Optional[float] = small_sample_guard_factor(n)
   702	        guarded: Optional[float] = guard * unguarded
   703	    else:
   704	        # Smoke-only diagnostics: unguarded components emitted, floor is null.
   705	        guard = None
   706	        guarded = None
   707	    return FloorEstimate(
   708	        kind=kind,
   709	        n=n,
   710	        mean_j=mean,
   711	        deviations_j=tuple(deviations),
   712	        sample_stddev_j=s,
   713	        max_abs_deviation_j=max_abs,
   714	        t_critical=t_critical,
   715	        prediction_component_j=prediction,
   716	        unguarded_floor_j=unguarded,
   717	        guard_factor=guard,
   718	        guarded_floor_j=guarded,
   719	    )
