  2013	            Path(args.floor_artifact),
  2014	            strict_validator=validate_bundle,
  2015	            evidence_roots=args.evidence_roots,
  2016	            output_path=Path(args.output),
  2017	            legacy_l1_mechanics=args.legacy_l1_mechanics,
  2018	            legacy_allowlist=_STRICT_LEGACY_BUNDLE_IDENTITIES,
  2019	        )
  2020	    except (AnalysisInputError, ClaimArtifactError, ValueError) as exc:
  2021	        print(f"error: {exc}", file=sys.stderr)
  2022	        return 2
  2023	    except OSError as exc:
  2024	        print(f"error: cannot write claim-verdict artifact: {exc}", file=sys.stderr)
  2025	        return 3
  2026	    outcomes: dict[str, int] = {}
  2027	    for contrast in artifact["contrasts"]:
  2028	        outcome = contrast["claim_evaluation"]["outcome"]
  2029	        outcomes[outcome] = outcomes.get(outcome, 0) + 1
  2030	    counts = ",".join(f"{key}={outcomes[key]}" for key in sorted(outcomes))
  2031	    print(
  2032	        f"claim-verdicts: {args.output} id={artifact['claim_verdicts_id']} "
  2033	        f"contrasts={len(artifact['contrasts'])} outcomes={counts}"
  2034	    )
