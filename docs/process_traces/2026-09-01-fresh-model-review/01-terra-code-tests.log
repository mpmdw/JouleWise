   144	def emitted_freeze_ratification() -> str:
   145	    """Return the reference-cadence ratification byte for the target generation.
   146	
   147	    Same contract as ``emitted_draft_status``: the ordinal-1 literal is the one
   148	    the 2026-08-13 freeze receipt pins and is never repaired, and successors get
   149	    wording whose truth does not turn on their own D-134 receipt. Nothing in
   150	    production reads this field -- it is advisor-visible description only (the
   151	    only in-tree readers are this generator and
   152	    ``tests/test_d117_decode_contrast_plan.py``) -- which is exactly why a
   153	    stale-on-mint literal would survive unnoticed.
   154	    """
   155	
   156	    if active_generation().target_is_successor_family:
   157	        return SUCCESSOR_FREEZE_RATIFICATION
