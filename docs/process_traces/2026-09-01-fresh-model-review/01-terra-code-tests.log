   195	
   196	def emitted_draft_status() -> str:
   197	    """Return the descriptive status byte written into generated artifacts.
   198	
   199	    This is deliberately NOT ``GenerationIdentity.target_status``. That
   200	    property is the dynamic, authenticated freeze state and remains the
   201	    authority a reader should consult; this function returns the generation-
   202	    time description that gets serialized into bytes the D-134 receipt pins.
   203	    Under the 2026-08-18 cold-gate verdict (holding 6) those bytes must never
   204	    transition, so the value they carry is freeze-neutral by construction and
   205	    ``FROZEN_STATUS`` is unreachable from every serialization site by design.
   206	    """
   207	
