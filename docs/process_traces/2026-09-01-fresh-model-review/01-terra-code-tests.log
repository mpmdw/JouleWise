   333	        if floor is None or reasons & _NOT_RESOLVABLE:
   334	            outcome = "not_resolvable"
   335	        else:
   336	            if equivalence is None and abs(numeric_estimate) <= floor:
   337	                reasons.add("effect_not_above_floor")
   338	
   339	            if equivalence is not None:
   340	                margin = _finite(equivalence.get("margin")) if isinstance(equivalence, Mapping) else None
   341	                method = equivalence.get("method") if isinstance(equivalence, Mapping) else None
   342	                if margin is None or margin <= 0.0 or method != "tost_v1":
   343	                    reasons.add("equivalence_not_supported")
   344	                elif margin <= floor:
   345	                    reasons.add("equivalence_margin_not_above_floor")
   346	
   347	            if reasons & _NOT_RESOLVABLE:
   348	                outcome = "not_resolvable"
   349	            elif reasons & _UNRESOLVED:
   350	                outcome = "unresolved"
   351	            elif equivalence is not None:
   352	                margin = float(equivalence["margin"])
   353	                if (
   354	                    not _inside_equivalence(metrology_interval, margin)
   355	                    or not _inside_equivalence(decision, margin)
   356	                    or not adjusted_rejected
   357	                ):
   358	                    reasons.add("equivalence_not_supported")
   359	                    outcome = "unresolved"
   360	                else:
   361	                    outcome = "equivalent"
   362	            elif (
   363	                metrology_interval[0] <= 0.0 <= metrology_interval[1]
   364	                or decision[0] <= 0.0 <= decision[1]
   365	            ):
   366	                if not (metrology_interval[0] <= 0.0 <= metrology_interval[1]):
   367	                    reasons.add("deterministic_bound_obscures_direction")
   368	                    outcome = "not_resolvable"
   369	                else:
   370	                    outcome = "unresolved"
   371	            elif not adjusted_rejected:
   372	                reasons.add("multiplicity_not_rejected")
   373	                outcome = "unresolved"
   374	            else:
   375	                outcome = "direction_supported"
   376	
   377	    direction = None
   378	    if outcome == "direction_supported" and numeric_estimate is not None:
   379	        direction = "positive" if numeric_estimate > 0.0 else "negative"
   380	
   381	    demoted = confirmatory_status != "confirmatory"
   382	    legacy = evidence_class == "legacy_l1"
   383	    sensitivity_reasons = reasons & {
   384	        "randomization_sensitivity_disagrees",
   385	        "loo_verdict_influential",
   386	        "randomization_check_insufficient_blocks",
   387	    }
   388	    direction_matches_registration = bool(
   389	        hypothesized_direction not in {"positive", "negative"}
   390	        or outcome == "equivalent"
   391	        or direction == hypothesized_direction
   392	    )
   393	    claim_ready = bool(
   394	        outcome in {"direction_supported", "equivalent"}
   395	        and claim_role in {"primary", "secondary"}
   396	        and not demoted
   397	        and not legacy
   398	        and not sensitivity_blocking
   399	        and not sensitivity_reasons
   400	        and direction_matches_registration
   401	    )
   402	    ceiling = "L2" if claim_ready else "L1"
   403	
   404	    ordered = ordered_reason_codes(reasons)
   405	    result = {
   406	        "outcome": outcome,
   407	        "direction": direction,
   408	        "reason_codes": ordered,
   409	        "claim_ready_for_l2_l3": claim_ready,
   410	        "claim_level_ceiling": ceiling,
