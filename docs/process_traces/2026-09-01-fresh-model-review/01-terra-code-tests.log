   186	def freeze_aware_status(freeze_reference: object) -> str:
   187	    """Return future-pack status without rewriting the 2026-08-13 frozen bytes."""
   188	
   189	    if not isinstance(freeze_reference, dict):
   190	        return DRAFT_STATUS
   191	    if freeze_reference.get("sha256") == CURRENT_FROZEN_RECEIPT_SHA256:
   192	        return DRAFT_STATUS
   193	    return FROZEN_STATUS
