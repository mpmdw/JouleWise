   591	def dominance_ratio(
   592	    *, corner_widened_unguarded_floor_j: float, point_unguarded_floor_j: float
   593	) -> dict[str, Any]:
   594	    """Evaluate the frozen R predicate without admitting Inf or NaN."""
   595	
   596	    numerator = float(corner_widened_unguarded_floor_j)
   597	    denominator = float(point_unguarded_floor_j)
   598	    if not math.isfinite(numerator) or numerator < 0.0:
   599	        raise ValueError("dominance_ratio_nonfinite_or_negative_numerator")
   600	    if not math.isfinite(denominator) or denominator < 0.0:
   601	        raise ValueError("dominance_ratio_nonfinite_or_negative_denominator")
   602	    if denominator == 0.0:
   603	        raise ValueError(DOMINANCE_ZERO_DENOMINATOR_REASON)
   604	    ratio = numerator / denominator
   605	    if not math.isfinite(ratio):
   606	        raise ValueError("dominance_ratio_nonfinite_result")
   607	    return {
   608	        "ratio": ratio,
   609	        "threshold": DOMINANCE_THRESHOLD,
   610	        "comparison": DOMINANCE_COMPARISON,
   611	        "passes": ratio >= DOMINANCE_THRESHOLD,
   612	    }
   613	
   614	
   615	def _outward_four(value: float, direction: float) -> float:
   616	    for _ in range(4):
   617	        value = math.nextafter(value, direction)
   618	    return value
   619	
   620	
   621	def _common_mode_replay_finite(value: object) -> float:
   622	    if isinstance(value, bool) or not isinstance(value, (int, float)):
   623	        raise ValueError("common_mode_replay_input_invalid")
   624	    converted = float(value)
   625	    if not math.isfinite(converted):
   626	        raise ValueError("common_mode_replay_input_invalid")
   627	    return converted
   628	
   629	
   630	def _common_mode_replay_values(values: object) -> tuple[float, ...]:
   631	    if isinstance(values, (str, bytes)) or not isinstance(values, Sequence):
   632	        raise ValueError("common_mode_replay_input_invalid")
   633	    return tuple(_common_mode_replay_finite(value) for value in values)
   634	
   635	
   636	def _common_mode_split(block: dict[str, Any]) -> tuple[float, float]:
   637	    """Replay the registered block-width split before its lossy final sum."""
   638	
   639	    try:
   640	        delta = _common_mode_replay_finite(block["delta_j"])
   641	        onset = _common_mode_replay_values(block["onset_sweep_j"])
   642	        offset = _common_mode_replay_values(block["offset_sweep_j"])
   643	        zero_point = _common_mode_replay_finite(block["zero_point_contrast_j"])
   644	        residuals = _common_mode_replay_values(
   645	            block["bundle_residual_half_widths_j"]
   646	        )
   647	        envelope = _common_mode_replay_finite(
   648	            block["member_envelope_integral_sum_j"]
   649	        )
   650	    except (KeyError, TypeError) as exc:
   651	        raise ValueError("common_mode_replay_input_invalid") from exc
   652	    values = (delta, zero_point, envelope, *onset, *offset, *residuals)
   653	    if (
   654	        not onset
   655	        or not offset
   656	        or len(residuals) != 4
   657	        or any(not math.isfinite(value) for value in values)
   658	        or envelope < 0.0
   659	        or any(value < 0.0 for value in residuals)
   660	    ):
   661	        raise ValueError("common_mode_replay_input_invalid")
   662	    envelope = max(
   663	        envelope,
   664	        1.0,
   665	        abs(delta),
   666	        abs(zero_point),
   667	        *(abs(value) for value in onset),
   668	        *(abs(value) for value in offset),
   669	    )
   670	    extrema_pad = 64.0 * (math.ulp(1.0) / 2.0) * envelope
   671	    excursion_lower = math.fsum((min(onset), -zero_point, min(offset), -zero_point))
   672	    excursion_upper = math.fsum((max(onset), -zero_point, max(offset), -zero_point))
   673	    lower = _outward_four(math.fsum((excursion_lower, -extrema_pad)), -math.inf)
   674	    upper = _outward_four(math.fsum((excursion_upper, extrema_pad)), math.inf)
   675	    zero_centred = _outward_four(max(abs(lower), abs(upper)), math.inf)
   676	    shared = _outward_four(
   677	        math.fsum((zero_centred, abs(zero_point - delta))), math.inf
   678	    )
   679	    local = math.fsum(residuals) / 2.0
   680	    return shared, local
   681	
   682	
   683	def replay_common_mode_dominance(
   684	    blocks: list[dict[str, Any]], *, calibration_bracket: object,
   685	    shared_edge_bound_s: float
   686	) -> dict[str, Any]:
   687	    """Compute R_cm from retained pre-mint inputs under the registered fence."""
   688	
   689	    if not blocks or len(blocks) > 20:
   690	        raise ValueError("common_mode_replay_block_count_invalid")
   691	    if isinstance(shared_edge_bound_s, bool) or not isinstance(
   692	        shared_edge_bound_s, (int, float)
   693	    ):
   694	        raise ValueError("common_mode_replay_authenticated_operative_bound_invalid")
   695	    bound = float(shared_edge_bound_s)
   696	    try:
   697	        authenticated_bound = registered_common_mode_operative_bound(
   698	            calibration_bracket
   699	        )
   700	    except CommonModeEstimatorRefusal as exc:
   701	        raise ValueError(
   702	            "common_mode_replay_authenticated_operative_bound_invalid"
   703	        ) from exc
   704	    if (
   705	        not math.isfinite(bound)
   706	        or bound <= 0.0
   707	        or not math.isclose(
   708	            bound,
   709	            authenticated_bound,
   710	            rel_tol=0.0,
   711	            abs_tol=1e-12,
   712	        )
   713	    ):
   714	        raise ValueError("common_mode_replay_authenticated_operative_bound_invalid")
   715	    deltas: list[float] = []
   716	    splits: list[tuple[float, float]] = []
   717	    for block in blocks:
   718	        windows = block.get("member_window_bounds_s")
   719	        if (
   720	            not isinstance(windows, list)
   721	            or len(windows) != 4
   722	            or any(
   723	                not isinstance(window, list)
   724	                or len(window) != 2
   725	                or not _common_mode_window_is_strictly_noncollapsed(
   726	                    window[0], window[1], authenticated_bound
   727	                )
   728	                for window in windows
   729	            )
   730	        ):
   731	            raise ValueError("common_mode_replay_window_domain_invalid")
   732	        split = _common_mode_split(block)
   733	        delta = _common_mode_replay_finite(block["delta_j"])
   734	        zero_point = _common_mode_replay_finite(block["zero_point_contrast_j"])
   735	        onset = _common_mode_replay_values(block["onset_sweep_j"])
   736	        offset = _common_mode_replay_values(block["offset_sweep_j"])
   737	        if zero_point not in onset or zero_point not in offset:
   738	            raise ValueError("common_mode_replay_zero_point_membership_invalid")
   739	        if not math.isclose(zero_point, delta, rel_tol=1e-9, abs_tol=1e-12):
   740	            raise ValueError(
   741	                "common_mode_replay_zero_point_divergence_out_of_domain"
   742	            )
   743	        deltas.append(delta)
   744	        splits.append(split)
   745	    point_floor = comparative_false_effect_floor(
   746	        deltas, admissible_half_widths_j=[0.0] * len(deltas)
   747	    ).unguarded_floor_j
   748	    common_mode_floor = 0.0
   749	    for shared_sign in (-1.0, 1.0):
   750	        for local_mask in range(1 << len(blocks)):
   751	            corner = [
   752	                delta
   753	                + shared_sign * shared
   754	                + (local if local_mask & (1 << index) else -local)
   755	                for index, (delta, (shared, local)) in enumerate(
   756	                    zip(deltas, splits, strict=True)
   757	                )
   758	            ]
   759	            floor = comparative_false_effect_floor(
   760	                corner, admissible_half_widths_j=[0.0] * len(corner)
   761	            ).unguarded_floor_j
   762	            common_mode_floor = max(common_mode_floor, floor)
   763	    result = dominance_ratio(
   764	        corner_widened_unguarded_floor_j=common_mode_floor,
   765	        point_unguarded_floor_j=point_floor,
   766	    )
   767	    return {
   768	        "rule_id": COMMON_MODE_REPLAY_RULE_ID,
   769	        "point_unguarded_floor_j": point_floor,
   770	        "common_mode_corner_widened_unguarded_floor_j": common_mode_floor,
   771	        **result,
   772	    }
