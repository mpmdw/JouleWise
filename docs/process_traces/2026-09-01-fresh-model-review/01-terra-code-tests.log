   806	def admissible_set_uncertainty_dominates_point_floor(
   807	    estimate: FloorEstimate,
   808	) -> bool:
   809	    """Classify the registered D-078 condition without turning it into refusal.
   810	
   811	    This reproduces the original terminal gate's exact comparison: the
   812	    largest linear residual/contrast admitted by the member anchor envelopes
   813	    is compared with the guarded point-only false-effect floor.  The complete
   814	    corner-maximized floor remains the published number.
   815	    """
   816	
   817	    widths = estimate.admissible_half_widths_j
   818	    if not widths or not any(widths):
   819	        return False
   820	    diagnostic = _point_floor_diagnostic(estimate)
   821	    point_gate = diagnostic["guarded_floor_j"]
   822	    if point_gate is None:
   823	        point_gate = diagnostic["unguarded_floor_j"]
   824	    if estimate.kind == "absolute":
   825	        n = estimate.n
   826	        width_sum = math.fsum(widths)
   827	        uncertainty_max = max(
   828	            abs(residual)
   829	            + width * (n - 1) / n
   830	            + (width_sum - width) / n
   831	            for residual, width in zip(
   832	                estimate.deviations_j, widths, strict=True
   833	            )
   834	        )
   835	    elif estimate.kind == "comparative":
   836	        uncertainty_max = _linear_corner_widened_max(
   837	            estimate.deviations_j, widths
   838	        )
   839	    else:
   840	        raise ValueError(f"unknown floor kind: {estimate.kind!r}")
   841	    return uncertainty_max > point_gate
