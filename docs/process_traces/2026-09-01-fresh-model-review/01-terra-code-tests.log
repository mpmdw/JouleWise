  3358	def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
  3359	    parser = argparse.ArgumentParser(description=__doc__)
  3360	    parser.add_argument("--check", action="store_true")
  3361	    parser.add_argument("--output-root", type=Path)
  3362	    parser.add_argument("--panel", required=True, type=Path)
  3363	    parser.add_argument("--model-a", required=True)
  3364	    parser.add_argument("--model-b", required=True)
  3365	    parser.add_argument(
  3366	        "--decode-workload",
  3367	        type=Path,
  3368	        default=Path("configs/workloads/real_prompts_v1.json"),
  3369	    )
  3370	    parser.add_argument(
  3371	        "--prefill-length",
  3372	        type=int,
  3373	        choices=(512, 1024, 2048, 4096),
  3374	    )
  3375	    parser.add_argument("--prefill-prompt-pin", type=Path)
  3376	    return parser.parse_args(argv)
