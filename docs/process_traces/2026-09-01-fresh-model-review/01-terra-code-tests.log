   241	  pr-fast:
   242	    # ==================================================================
   243	    # ADDITIVE EARLY SIGNAL. THIS JOB IS NOT A GATE AND NEVER SUBSTITUTES
   244	    # FOR THE FULL SUITE.
   245	    #
   246	    # Read this before touching anything below. The authoritative gate for
   247	    # every merge, every whole-window verdict, and every audited head
   248	    # remains the FULL suite: the `test` shard matrix plus both exclusive
   249	    # module jobs, all of which continue to run on this same pull request
   250	    # exactly as they did before this job existed. Nothing was removed from
   251	    # them and no required check changed. This job only reports an obvious
   252	    # breakage sooner — roughly 4 minutes instead of roughly 17 — so a
   253	    # contributor is not left waiting on the full matrix to learn they
   254	    # broke an import.
   255	    #
   256	    # Consequently a GREEN pr-fast means nothing on its own. A RED pr-fast
   257	    # is real information (something is definitely broken); a green one is
   258	    # merely the absence of early bad news. Do not promote this job to a
   259	    # required status check, and do not let its result stand in for the
   260	    # full suite in any merge, verdict, or audit decision. If you ever want
   261	    # it to gate, that is a lead-gated required-check change and must be
   262	    # proposed, not applied here.
   263	    #
   264	    # WHAT IT RUNS: every ordinary module whose measured hosted weight is
   265	    # at or below scripts/test_timings.json's pr_fast_tier.max_module_seconds
   266	    # (30 s). At the 2026-08-23 hosted measurement that is 126 of 138
   267	    # modules and 2848 of 3804 test methods — 74.9% of the suite's tests
   268	    # for 10.7% of its runtime. The excluded modules are the measured heavy
   269	    # tail; they carry 25.1% of the tests but 89.3% of the cost, which is
   270	    # exactly why they are the ones the full suite keeps and this job drops.
   271	    #
   272	    # The module list is DERIVED AT RUN TIME from the timing map, never
   273	    # checked in, so a newly added test module cannot silently fall out of
   274	    # it. An unmeasured module takes the conservative unknown weight
   275	    # (29.834 s), which is below the cutoff, so new modules are INCLUDED by
   276	    # default — for an additive tier the safe failure is running too much.
   277	    # ==================================================================
   278	    if: github.event_name == 'pull_request'
   279	    runs-on: ubuntu-latest
   280	    strategy:
   281	      fail-fast: false
   282	      matrix:
   283	        shard: [1, 2]
   284	    steps:
   285	      - uses: actions/checkout@v5
   286	        with:
   287	          fetch-depth: 0
   288	      - uses: actions/setup-python@v6
   289	        with:
   290	          # 3.11 only. The full suite covers 3.11 and 3.14; this tier is a
   291	          # latency device, not a compatibility matrix, and 3.11 is the
   292	          # consistently slower (therefore binding) interpreter.
   293	          python-version: "3.11"
   294	      - name: Compile Python sources
   295	        run: python -m compileall -q joulewise tests
   296	      - name: Fast tier - light modules only (NOT A GATE; full suite still runs)
   297	        env:
   298	          SHARD_INDEX: ${{ matrix.shard }}
   299	        run: |
   300	          python - <<'PY'
   301	          import json
   302	          import os
   303	          from pathlib import Path
   304	          import sys
   305	
   306	          sys.path.insert(0, "scripts")
   307	          import shard_tests
   308	
   309	          payload = json.loads(Path("scripts/test_timings.json").read_text())
   310	          policy = payload["pr_fast_tier"]
   311	          cutoff = float(policy["max_module_seconds"])
   312	          shards = int(policy["shards"])
   313	          exclusive = frozenset(payload["exclusive_modules"])
   314	          timings = shard_tests.load_timing_map()
   315	          unknown = shard_tests.conservative_unknown_weight()
   316	
   317	          discovered = shard_tests.discover_test_modules()
   318	          selected = tuple(
   319	              module
   320	              for module in discovered
   321	              if module not in exclusive and timings.get(module, unknown) <= cutoff
   322	          )
   323	          dropped = [
   324	              module
   325	              for module in discovered
   326	              if module not in exclusive and module not in selected
   327	          ]
   328	          print(f"FAST TIER selected={len(selected)} dropped={len(dropped)} of {len(discovered)}")
   329	          print("FAST TIER dropped heavy tail: " + ", ".join(sorted(dropped)))
   330	          if not selected:
   331	              raise SystemExit("fast tier selected zero modules; refusing to report success")
   332	
   333	          partitions = shard_tests.partition_modules(
   334	              selected, timings, shards, unknown_weight=unknown
   335	          )
   336	          totals = shard_tests.partition_totals(
   337	              partitions, timings, unknown_weight=unknown
   338	          )
   339	          print("FAST SHARD ESTIMATES", ",".join(f"{value:.3f}" for value in totals))
   340	          index = int(os.environ["SHARD_INDEX"])
   341	          raise SystemExit(shard_tests.run_shard(partitions[index - 1], shards, index))
   342	          PY
   343	
   344	  build:
   345	    runs-on: ubuntu-latest
   346	    steps:
   347	      - uses: actions/checkout@v5
   348	      - uses: actions/setup-python@v6
   349	        with:
   350	          python-version: "3.11"
   351	      - name: Install build frontend
   352	        run: python -m pip install build
   353	      - name: Build wheel and source distribution
