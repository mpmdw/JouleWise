  2552	            coefficients[position]
  2553	            * _integrate(
  2554	                by_position[position][0],
  2555	                by_position[position][1].start_s + onset_s,
  2556	                by_position[position][1].end_s + offset_s,
  2557	            )
  2558	            for position in _ABBA_POSITIONS
  2559	        )
