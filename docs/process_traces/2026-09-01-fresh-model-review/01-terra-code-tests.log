  3379	def main(argv: list[str] | None = None) -> int:
  3380	    args = parse_args(argv)
  3381	    configure_model_pair(
  3382	        args.panel,
  3383	        args.model_a,
  3384	        args.model_b,
  3385	        decode_workload_path=args.decode_workload,
  3386	        prefill_length=args.prefill_length,
  3387	        prefill_prompt_pin_path=args.prefill_prompt_pin,
  3388	    )
  3389	    identity = GenerationIdentity()
  3390	    hashes = (
  3391	        check(
  3392	            args.output_root.resolve() if args.output_root else REPO_ROOT,
  3393	            identity,
  3394	        )
  3395	        if args.check
  3396	        else generate(
  3397	            args.output_root.absolute() if args.output_root else REPO_ROOT,
  3398	            identity,
  3399	        )
  3400	    )
  3401	    mode = "checked" if args.check else "generated"
  3402	    status = identity.target_status
  3403	    identity_label = (
  3404	        status.replace("_", " ")
  3405	        if identity.target_ordinal == 1
  3406	        else identity.pack_id
  3407	    )
  3408	    print(
  3409	        f"{mode} D-117 gamma {identity_label}: "
  3410	        f"decode_members={MEMBERS_PER_ARM} {PREFILL_ARM}_members={MEMBERS_PER_ARM} "
  3411	        f"plan_sha256={hashes['plan_sha256']} tree_sha256={hashes['tree_sha256']}"
  3412	    )
  3413	    return 0
