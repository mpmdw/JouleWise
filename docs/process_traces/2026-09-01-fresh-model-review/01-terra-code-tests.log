   726	        raise ValueError("admissible-set half-widths are required")
   727	    widths = _clean_values(widths_j, "admissible-set half-widths")
   728	    if len(widths) != expected_n:
   729	        raise ValueError("admissible-set half-width count must match point estimates")
   730	    if any(value < 0.0 for value in widths):
   731	        raise ValueError("admissible-set half-widths must be >= 0")
