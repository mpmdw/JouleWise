   723	def _find_region(text: str, begin: str, end: str, path: str):
   724	    starts = [m.start() for m in re.finditer(re.escape(begin), text)]
   725	    ends = [m.start() for m in re.finditer(re.escape(end), text)]
   726	    if len(starts) != 1 or len(ends) != 1:
   727	        fail(f"{path}: expected exactly one {begin!r}/{end!r} marker pair"
   728	             f" (found {len(starts)}/{len(ends)})")
   729	    if ends[0] < starts[0]:
   730	        fail(f"{path}: reversed markers")
   731	    region_end = ends[0] + len(end)
   732	    if text[region_end:region_end + 1] not in ("", "\n"):
   733	        fail(f"{path}: end marker must terminate its line")
   734	    return starts[0], region_end
   735	
   736	
   737	def replace_region(text: str, rendered: str, begin: str, end: str, path: str) -> str:
   738	    start, stop = _find_region(text, begin, end, path)
   739	    return text[:start] + rendered.rstrip("\n") + text[stop:]
   740	
   741	
   742	def _read(path: str) -> str:
   743	    try:
   744	        with open(path, encoding="utf-8") as fh:
   745	            return fh.read()
   746	    except OSError as exc:
   747	        fail(f"cannot read {path}: {exc}")
   748	
   749	
   750	def _atomic_write(path: str, data: bytes) -> None:
   751	    directory = os.path.dirname(path) or "."
   752	    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".gen_state.")
   753	    try:
   754	        with os.fdopen(fd, "wb") as fh:
   755	            fh.write(data)
   756	        os.replace(tmp, path)
   757	    except BaseException:
   758	        if os.path.exists(tmp):
   759	            os.unlink(tmp)
   760	        raise
   761	
   762	
   763	# ---------------------------------------------------------------------------
   764	# Entry points
   765	# ---------------------------------------------------------------------------
   766	
   767	def load_kernel(path: str):
   768	    raw = _read(path)
   769	    try:
   770	        kernel = json.loads(raw)
   771	    except ValueError as exc:
   772	        fail(f"{path}: invalid JSON: {exc}")
   773	    validate(kernel)
   774	    return kernel, raw.encode("utf-8")
   775	
   776	
   777	def main(argv=None) -> int:
   778	    parser = argparse.ArgumentParser(description=__doc__)
   779	    parser.add_argument("--check", action="store_true")
   780	    parser.add_argument("--stdout", choices=("run-state", "queue"))
   781	    parser.add_argument("--kernel", default=os.path.join(ROOT, *KERNEL_REL.split("/")))
   782	    parser.add_argument("--run-state", default=os.path.join(ROOT, "RUN_STATE.md"))
   783	    parser.add_argument("--queue", default=os.path.join(ROOT, "TASK_QUEUE.md"))
   784	    args = parser.parse_args(argv)
   785	
   786	    try:
   787	        kernel, raw = load_kernel(args.kernel)
   788	        canonical = canonical_bytes(kernel)
   789	
   790	        if args.stdout:
   791	            fragment = render_run_state(kernel) if args.stdout == "run-state" else render_queue(kernel)
   792	            sys.stdout.write(fragment)
   793	            return 0
   794	
   795	        targets = (
   796	            (args.run_state, render_run_state(kernel), RS_BEGIN, RS_END),
   797	            (args.queue, render_queue(kernel), Q_BEGIN, Q_END),
   798	        )
   799	
   800	        if args.check:
   801	            drift = False
   802	            if raw != canonical:
   803	                fail(f"{args.kernel}: kernel bytes are not canonical")
   804	            for path, rendered, begin, end in targets:
   805	                text = _read(path)
   806	                if replace_region(text, rendered, begin, end, path) != text:
   807	                    print(f"DRIFT: {path} generated region differs", file=sys.stderr)
   808	                    drift = True
   809	            return 1 if drift else 0
   810	
   811	        if raw != canonical:
   812	            _atomic_write(args.kernel, canonical)
   813	        for path, rendered, begin, end in targets:
   814	            text = _read(path)
   815	            updated = replace_region(text, rendered, begin, end, path)
   816	            if updated != text:
   817	                _atomic_write(path, updated.encode("utf-8"))
   818	        return 0
   819	    except KernelError as exc:
   820	        print(f"gen_state: {exc}", file=sys.stderr)
   821	        return 2
   822	
   823	
   824	if __name__ == "__main__":
   825	    sys.exit(main())

