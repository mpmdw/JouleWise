     3	on:
     4	  push:
     5	    branches: [main]
     6	  pull_request:
     7	
     8	jobs:
     9	  test:
    10	    runs-on: ubuntu-latest
    11	    strategy:
    12	      matrix:
    13	        # 3.11 is the supported floor (pyproject); 3.14 matches local dev.
    14	        python-version: ["3.11", "3.14"]
    15	        shard: [1, 2, 3, 4]
    16	    steps:
    17	      - uses: actions/checkout@v5
    18	        with:
    19	          # Golden provenance sidecars replay `git archive` against their
    20	          # pinned base commit; a shallow checkout lacks that object.
    21	          fetch-depth: 0
    22	      - uses: actions/setup-python@v6
    23	        with:
    24	          python-version: ${{ matrix.python-version }}
    25	      - name: State kernel and generated-view drift
    26	        run: python scripts/gen_state.py --check
    27	      - name: Historical receipt semantics
    28	        run: python scripts/verify_receipt_histsem.py --repository-root . --require-published
    29	      - name: Compile Python sources
    30	        run: python -m compileall -q joulewise tests
    31	      - name: Unit tests (stdlib core only, per D-009/D-017)
    32	        # test_calibration_exits AND test_calibration_writer_crash_matrix
    33	        # are intentionally absent here (both carry exclusive_modules
    34	        # declarations): their evidence makes fallback-weight shard
    35	        # placement unsound; each runs once in its exclusive job below,
    36	        # while the remaining four shards retain deterministic LPT balance
    37	        # from the ordinary timing map.
    38	        env:
    39	          SHARD_INDEX: ${{ matrix.shard }}
    40	        run: |
    41	          python - <<'PY'
    42	          import json
    43	          import os
    44	          from pathlib import Path
    45	          import sys
    46	
    47	          sys.path.insert(0, "scripts")
    48	          import shard_tests
    49	
    50	          overlay = json.loads(Path("scripts/test_timings.json").read_text())
    51	          declarations = overlay["exclusive_modules"]
    52	          exclusive = frozenset(declarations)
    53	          discovered = shard_tests.discover_test_modules()
    54	          assert exclusive <= set(discovered), (exclusive, discovered)
    55	          timings = shard_tests.load_timing_map()
    56	          for module, declaration in declarations.items():
    57	              seconds = float(declaration["seconds"])
    58	              threshold = float(declaration["fallback_rejection_threshold_seconds"])
    59	              assert seconds >= threshold, (module, seconds, threshold)
    60	              timings[module] = seconds
    61	          ordinary = tuple(module for module in discovered if module not in exclusive)
    62	
    63	          # UNIT-atomic, not module-atomic. A shard's floor used to be the
    64	          # single largest MODULE, and tests.test_reduce alone is 1544 s --
    65	          # larger than an even four-way share -- so NO shard count could
    66	          # get below it. Modules named in split_modules are spread across
    67	          # shards at test granularity instead. This edits no test file and
    68	          # skips nothing: expand_units emits one unit per declared heavy
    69	          # test plus ONE remainder unit holding every other test in that
    70	          # module, and verify_split_declaration fails the build closed if
    71	          # a declared id no longer exists.
    72	          splits = {
    73	              module: declaration
    74	              for module, declaration in shard_tests.load_split_declarations().items()
    75	              if module in set(ordinary)
    76	          }
    77	          unknown = shard_tests.conservative_unknown_weight()
    78	          units, weights = shard_tests.expand_units(
    79	              ordinary, timings, splits, unknown_weight=unknown
    80	          )
    81	          partitions = shard_tests.partition_modules(
    82	              units, weights, 4, unknown_weight=unknown
    83	          )
    84	          totals = shard_tests.partition_totals(
    85	              partitions, weights, unknown_weight=unknown
    86	          )
    87	          print("ORDINARY SHARD ESTIMATES", ",".join(f"{value:.3f}" for value in totals))
    88	          index = int(os.environ["SHARD_INDEX"])
    89	          raise SystemExit(shard_tests.run_units(partitions[index - 1], 4, index))
    90	          PY
    91	      - name: CLI smoke - validate example configs
    92	        run: |
    93	          python -m joulewise validate-config configs/examples/mock_local.json
    94	          python -m joulewise validate-config configs/examples/mac_mlx_local.json
    95	      - name: Strict mock run, validate, reduce, and revalidate
    96	        run: |
    97	          set -euo pipefail
    98	          line=$(python -m joulewise run configs/examples/mock_local.json --runs-dir ci-runs)
    99	          echo "$line"
   100	          bundle=${line#bundle: }
   101	          bundle=${bundle%% *}
   102	          python -m joulewise validate-bundle --strict "$bundle"
   103	          python -m joulewise reduce "$bundle"
   104	          python -m joulewise validate-bundle --strict "$bundle"
   105	
   106	  calibration-exits-exclusive:
   107	    # Exclusive by design: this module already runs sequentially internally;
   108	    # colocating it with an ordinary shard only adds scheduler starvation.
   109	    # The module watchdog ceiling is 10 minutes per child and this hosted job
   110	    # retains the consult-dictated 30-minute absolute ceiling.
   111	    runs-on: ubuntu-latest
   112	    timeout-minutes: 30
   113	    strategy:
   114	      matrix:
   115	        python-version: ["3.11", "3.14"]
   116	    steps:
   117	      - uses: actions/checkout@v5
   118	        with:
   119	          fetch-depth: 0
   120	      - uses: actions/setup-python@v6
   121	        with:
   122	          python-version: ${{ matrix.python-version }}
   123	      - name: Validate exclusive timing declaration
   124	        run: |
   125	          python - <<'PY'
   126	          import json
   127	          from pathlib import Path
   128	          payload = json.loads(Path("scripts/test_timings.json").read_text())
   129	          row = payload["exclusive_modules"]["tests.test_calibration_exits"]
   130	          assert row["evidence_range_seconds"] == [648.0, 2036.0]
   131	          assert row["seconds"] == 2036.0
   132	          assert payload["seconds_by_module"]["tests.test_calibration_exits"] == row["seconds"]
   133	          assert row["seconds"] >= row["fallback_rejection_threshold_seconds"]
   134	          PY
   135	      - name: Compile calibration-exit sources
   136	        run: python -m compileall -q joulewise tests scripts/validate_powermetrics_fiducial.py
   137	      - name: Exclusive calibration-exit module
   138	        run: python -m unittest -v tests.test_calibration_exits
