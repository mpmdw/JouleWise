   591	def dominance_ratio(
   592	    *, corner_widened_unguarded_floor_j: float, point_unguarded_floor_j: float
   593	) -> dict[str, Any]:
   594	    """Evaluate the frozen R predicate without admitting Inf or NaN."""
   595	
   596	    numerator = float(corner_widened_unguarded_floor_j)
   597	    denominator = float(point_unguarded_floor_j)
   598	    if not math.isfinite(numerator) or numerator < 0.0:
   599	        raise ValueError("dominance_ratio_nonfinite_or_negative_numerator")
   600	    if not math.isfinite(denominator) or denominator < 0.0:
   601	        raise ValueError("dominance_ratio_nonfinite_or_negative_denominator")
   602	    if denominator == 0.0:
   603	        raise ValueError(DOMINANCE_ZERO_DENOMINATOR_REASON)
   604	    ratio = numerator / denominator
   605	    if not math.isfinite(ratio):
   606	        raise ValueError("dominance_ratio_nonfinite_result")
   607	    return {
   608	        "ratio": ratio,
   609	        "threshold": DOMINANCE_THRESHOLD,
   610	        "comparison": DOMINANCE_COMPARISON,
   611	        "passes": ratio >= DOMINANCE_THRESHOLD,
   612	    }
