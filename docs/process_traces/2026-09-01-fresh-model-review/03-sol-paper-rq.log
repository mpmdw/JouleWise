   196	def emitted_draft_status() -> str:
   197	    """Return the descriptive status byte written into generated artifacts.
   198	
   199	    This is deliberately NOT ``GenerationIdentity.target_status``. That
   200	    property is the dynamic, authenticated freeze state and remains the
   201	    authority a reader should consult; this function returns the generation-
   202	    time description that gets serialized into bytes the D-134 receipt pins.
   203	    Under the 2026-08-18 cold-gate verdict (holding 6) those bytes must never
   204	    transition, so the value they carry is freeze-neutral by construction and
   205	    ``FROZEN_STATUS`` is unreachable from every serialization site by design.
   206	    """
   207	
   208	    identity = active_generation()
   209	    if identity.target_is_successor_family:
   210	        return SUCCESSOR_EMITTED_STATUS
   211	    # Ordinal-1 packs were frozen on 2026-08-13 with this literal serialized;
   212	    # preserve-mode replay reproduces those committed bytes verbatim. In an
   213	    # EMITTED successor generator this branch is unreachable by design: its own
   214	    # family ordinal is >= 2 and the downgrade guard in GenerationIdentity
   215	    # refuses every target below it before any write.
   216	    return DRAFT_STATUS
   217	
   218	
   219	def emitted_freeze_ratification() -> str:
   220	    """Return the reference-cadence ratification byte for the target generation.
   221	
   222	    Same contract as ``emitted_draft_status``: the ordinal-1 literal is the one
   223	    the 2026-08-13 freeze receipt pins and is never repaired, and successors get
   224	    wording whose truth does not turn on their own D-134 receipt. Nothing in
   225	    production reads this field -- it is advisor-visible description only (the
   226	    only in-tree readers are this generator and
   227	    ``tests/test_d117_decode_contrast_plan.py``) -- which is exactly why a
   228	    stale-on-mint literal would survive unnoticed.
   229	    """
   230	
   231	    if active_generation().target_is_successor_family:
   232	        return SUCCESSOR_FREEZE_RATIFICATION
   233	    return LEGACY_FREEZE_RATIFICATION
