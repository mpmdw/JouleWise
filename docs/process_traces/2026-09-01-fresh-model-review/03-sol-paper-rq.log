   221	
   222	# Re-derive summary metrics from a bundle's recorded trace/events (post-hoc):
   223	python3 -m joulewise reduce runs/example-mock-local
   224	
   225	# Render a static HTML run browser (first: pip install -e '.[analysis]'):
   226	python3 -m joulewise report runs --output report
