   636	def _common_mode_split(block: dict[str, Any]) -> tuple[float, float]:
   637	    """Replay the registered block-width split before its lossy final sum."""
   638	
   639	    try:
   640	        delta = _common_mode_replay_finite(block["delta_j"])
   641	        onset = _common_mode_replay_values(block["onset_sweep_j"])
   642	        offset = _common_mode_replay_values(block["offset_sweep_j"])
   643	        zero_point = _common_mode_replay_finite(block["zero_point_contrast_j"])
   644	        residuals = _common_mode_replay_values(
   645	            block["bundle_residual_half_widths_j"]
   646	        )
   647	        envelope = _common_mode_replay_finite(
   648	            block["member_envelope_integral_sum_j"]
   649	        )
   650	    except (KeyError, TypeError) as exc:
   651	        raise ValueError("common_mode_replay_input_invalid") from exc
   652	    values = (delta, zero_point, envelope, *onset, *offset, *residuals)
   653	    if (
   654	        not onset
   655	        or not offset
   656	        or len(residuals) != 4
   657	        or any(not math.isfinite(value) for value in values)
   658	        or envelope < 0.0
   659	        or any(value < 0.0 for value in residuals)
   660	    ):
   661	        raise ValueError("common_mode_replay_input_invalid")
   662	    envelope = max(
   663	        envelope,
   664	        1.0,
   665	        abs(delta),
   666	        abs(zero_point),
   667	        *(abs(value) for value in onset),
   668	        *(abs(value) for value in offset),
   669	    )
   670	    extrema_pad = 64.0 * (math.ulp(1.0) / 2.0) * envelope
   671	    excursion_lower = math.fsum((min(onset), -zero_point, min(offset), -zero_point))
   672	    excursion_upper = math.fsum((max(onset), -zero_point, max(offset), -zero_point))
   673	    lower = _outward_four(math.fsum((excursion_lower, -extrema_pad)), -math.inf)
   674	    upper = _outward_four(math.fsum((excursion_upper, extrema_pad)), math.inf)
   675	    zero_centred = _outward_four(max(abs(lower), abs(upper)), math.inf)
   676	    shared = _outward_four(
   677	        math.fsum((zero_centred, abs(zero_point - delta))), math.inf
   678	    )
   679	    local = math.fsum(residuals) / 2.0
   680	    return shared, local
