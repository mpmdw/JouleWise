   250	        if not self.family_suffix.startswith("_v") or not self.family_suffix[2:].isdigit():
   251	            raise ValueError("family suffix must use the _v<positive integer> form")
   252	        if int(self.family_suffix[2:]) < 1:
   253	            raise ValueError("family suffix ordinal must be positive")
   254	        expected_pack_id = (
   255	            PACK_REL.name.removesuffix(CURRENT_FAMILY_SUFFIX) + self.family_suffix
   256	        )
   257	        if self.pack_id != expected_pack_id:
   258	            raise ValueError(
   259	                f"pack id must equal {expected_pack_id!r} for {self.family_suffix}"
