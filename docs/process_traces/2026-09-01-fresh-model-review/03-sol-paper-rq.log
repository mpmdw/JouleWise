   650	    except (KeyError, TypeError) as exc:
   651	        raise ValueError("common_mode_replay_input_invalid") from exc
   652	    values = (delta, zero_point, envelope, *onset, *offset, *residuals)
   653	    if (
   654	        not onset
   655	        or not offset
   656	        or len(residuals) != 4
   657	        or any(not math.isfinite(value) for value in values)
