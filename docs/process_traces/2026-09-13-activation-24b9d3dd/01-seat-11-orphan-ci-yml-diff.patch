+  # FENCE for documentation-asserting tests on docs-only runs.
+  # This job never substitutes for the full suite.
+  # The module list is derived at run time from documentation paths in test source.
+  docs-readers:
+    needs: changes
+    if: ${{ !cancelled() && needs.changes.outputs.code != 'true' }}
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        shard: [1, 2]
+    steps:
+      - uses: actions/checkout@v5
+        with:
+          fetch-depth: 0
+      - uses: actions/setup-python@v6
+        with:
+          python-version: "3.11"
+      - name: Compile Python sources
+        run: python -m compileall -q joulewise tests
+      - name: Install zsh (the night driver, its installer, and the emitted G2-a chain are zsh; tests invoke /bin/zsh)
+        run: |
+          # Tests require /bin/zsh: /usr/bin/zsh without that symlink is insufficient.
+          if [ ! -x /bin/zsh ]; then
+            sudo apt-get update -q
+            sudo apt-get install -y -q zsh
+          fi
+          test -x /bin/zsh
+      - name: Documentation-reading unit tests
+        env:
+          SHARD_INDEX: ${{ matrix.shard }}
+        run: |
+          python - <<'PY'
+          import json
+          import os
+          from pathlib import Path
+          import re
+          import sys
+
+          sys.path.insert(0, "scripts")
+          import shard_tests
+
+          payload = json.loads(Path("scripts/test_timings.json").read_text())
+          exclusive = frozenset(payload["exclusive_modules"])
+          timings = shard_tests.load_timing_map()
+          unknown = shard_tests.conservative_unknown_weight()
+          doc_path = re.compile(r"[\"'](docs/|README\.md|RUN_STATE\.md|TASK_QUEUE\.md|AGENTS\.md|AGENT_PLAN\.md)")
+          sources = sorted(Path("tests").glob("test_*.py"))
+          selected = tuple(
+              f"tests.{path.stem}"
+              for path in sources
+              if f"tests.{path.stem}" not in exclusive
+              and doc_path.search(path.read_text(encoding="utf-8"))
+          )
+          print(f"DOCS READERS selected={len(selected)} of {len(sources)}")
+          print("\n".join(sorted(selected)))
+          if not selected:
+              raise SystemExit("docs readers selected zero modules; refusing to report success")
+
+          partitions = shard_tests.partition_modules(
+              selected, timings, 2, unknown_weight=unknown
+          )
+          totals = shard_tests.partition_totals(
+              partitions, timings, unknown_weight=unknown
+          )
+          print("DOCS READERS SHARD ESTIMATES", ",".join(f"{value:.3f}" for value in totals))
+          index = int(os.environ["SHARD_INDEX"])
+          raise SystemExit(shard_tests.run_units(partitions[index - 1], 2, index))
+          PY
+
