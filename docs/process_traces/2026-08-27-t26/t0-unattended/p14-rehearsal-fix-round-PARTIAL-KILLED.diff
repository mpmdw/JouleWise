+def _ledger_path_from_capture(capture: Mapping[str, Any]) -> Path:
+    argv = capture.get("argv")
+    if not isinstance(argv, list) or any(not isinstance(item, str) for item in argv):
+        raise ValueError("production ledger-reservation argv is malformed")
+    values = [argv[index + 1] for index, item in enumerate(argv[:-1]) if item == "--ledger"]
+    if len(values) != 1 or not Path(values[0]).is_absolute():
+        raise ValueError("production ledger-reservation capture does not bind exactly one absolute --ledger")
+    return Path(values[0])
+
