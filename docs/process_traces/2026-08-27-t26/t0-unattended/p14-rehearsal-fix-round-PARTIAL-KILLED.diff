+def _producer_bound_rehearsal_paths(
+    bundle: EvidenceBundle,
+) -> tuple[dict[str, Path] | None, tuple[Mapping[str, object], ...]]:
+    """Derive rehearsal paths from records the existing T-0 producer checks.
+
+    ``docs/phase_2/window_runbook.md`` names the six root/backup roles in
+    ``ARM_CONTEXT_JSON`` and the calibration ledger in the reservation command.
+    ``readiness.validate_arm_context`` owns the exact six path keys, while
+    ``arm_readiness_evidence_t0._derive_ledger`` authenticates the captured
+    reservation's ``--ledger`` and ledger bytes.  During a rehearsal these are
+    the rehearsal paths, not an authority for the production paths to avoid.
+    """
+
+    arm_candidates = [
+        item
+        for item in bundle.namespace_documents()
+        if Path(item.relative_path).name == "arm-context.json"
+    ]
+    ledger_candidates = [
+        item
+        for item in bundle.namespace_documents()
+        if isinstance(item.value, Mapping)
+        and item.value.get("schema_version")
+        == "joulewise.arm_readiness_t0_command_capture.v1"
+        and item.value.get("step_id") == "ledger-reservation"
+    ]
+    if not arm_candidates or not ledger_candidates:
+        return None, ()
+    if len(arm_candidates) != 1 or len(ledger_candidates) != 1:
+        raise ValueError("producer-bound rehearsal path evidence is ambiguous in the T-0 namespace")
+    arm_artifact = arm_candidates[0]
+    ledger_artifact = ledger_candidates[0]
+    if arm_artifact.parse_error is not None or not isinstance(arm_artifact.value, Mapping):
+        raise ValueError("producer-written arm-context.json is invalid")
+    if ledger_artifact.parse_error is not None or not isinstance(ledger_artifact.value, Mapping):
+        raise ValueError("producer-written ledger-reservation capture is invalid")
+    try:
+        arm = readiness.validate_arm_context(arm_artifact.value)
+    except readiness.ArmReadinessError as exc:
+        raise ValueError(f"producer-written arm-context.json is invalid: {exc}") from exc
+    unresolved = {
+        role: Path(str(arm[role])) for role in _PRODUCTION_ARM_CONTEXT_ROLES
+    }
+    unresolved["ledger_path"] = _ledger_path_from_capture(ledger_artifact.value)
+    resolved: dict[str, Path] = {}
+    for role, path in unresolved.items():
+        try:
+            target = path.resolve(strict=True)
+        except OSError as exc:
+            raise ValueError(f"producer-bound rehearsal path {role} cannot be resolved: {exc}") from exc
+        if target.is_symlink() or (role == "ledger_path" and not target.is_file()):
+            raise ValueError(f"producer-bound rehearsal path {role} is not a regular ledger file")
+        if role != "ledger_path" and not target.is_dir():
+            raise ValueError(f"producer-bound rehearsal path {role} is not a directory")
+        resolved[role] = target
+    return resolved, (arm_artifact.citation(), ledger_artifact.citation())
+
