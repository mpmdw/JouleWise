+class PromisorHistoryRefusalTests(unittest.TestCase):
+    """A blobless clone must never be completed by the histsem verifier."""
+
+    GIT_MAINTENANCE_CONTROLS = (
+        ("maintenance.auto", "false"),
+        ("gc.auto", "0"),
+        ("maintenance.autoDetach", "false"),
+        ("gc.autoDetach", "false"),
+    )
+
+    @classmethod
+    def _run(
+        cls,
+        *command: str,
+        cwd: Path | None = None,
+        env: dict[str, str] | None = None,
+    ) -> subprocess.CompletedProcess[str]:
+        return subprocess.run(
+            command,
+            cwd=cwd,
+            check=True,
+            capture_output=True,
+            text=True,
+            timeout=60,
+            env=env,
+        )
+
+    @classmethod
+    def setUpClass(cls) -> None:
+        started = time.monotonic()
+        cls.temporary = tempfile.TemporaryDirectory(
+            prefix="joulewise-histsem-promisor-test-"
+        )
+        cls.addClassCleanup(cls.temporary.cleanup)
+        cls.fixture_root = Path(cls.temporary.name)
+        cls.origin = cls.fixture_root / "origin.git"
+        cls.partial = cls.fixture_root / "partial"
+        cls.successor = cls.fixture_root / "successor"
+        cls.successor.mkdir()
+        cls._run(
+            "git",
+            "-c",
+            "gc.auto=0",
+            "-c",
+            "maintenance.auto=false",
+            "clone",
+            "-q",
+            "--bare",
+            "--no-local",
+            str(ROOT),
+            str(cls.origin),
+        )
+        for key, value in cls.GIT_MAINTENANCE_CONTROLS:
+            cls._run("git", "-C", str(cls.origin), "config", "--local", key, value)
+        cls._run(
+            "git",
+            "-C",
+            str(cls.origin),
+            "config",
+            "uploadpack.allowFilter",
+            "true",
+        )
+        cls._run(
+            "git",
+            "-C",
+            str(cls.origin),
+            "config",
+            "uploadpack.allowAnySHA1InWant",
+            "true",
+        )
+        cls._run(
+            "git",
+            "-c",
+            "gc.auto=0",
+            "-c",
+            "maintenance.auto=false",
+            "clone",
+            "-q",
+            "--filter=blob:none",
+            f"file://{cls.origin}",
+            str(cls.partial),
+        )
+        for key, value in cls.GIT_MAINTENANCE_CONTROLS:
+            cls._run("git", "-C", str(cls.partial), "config", "--local", key, value)
+        cls.pack_relative = REPRESENTATIVE_PACK.relative_to(ROOT).as_posix()
+        cls.pack = cls.partial / cls.pack_relative
+        pinset = json.loads(PINSET.read_bytes())
+        cls.historical_head = next(
+            row["head_commit"]
+            for row in pinset["packs"]
+            if row["pack_id"] == REPRESENTATIVE_PACK.name
+        )
+        cls.fixture_wall_seconds = time.monotonic() - started
+        print(
+            f"partial-clone fixture wall time: {cls.fixture_wall_seconds:.3f}s",
+            file=sys.stderr,
