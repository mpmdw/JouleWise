<plist version="1.0"><dict>
  <key>Label</key><string>com.joulewise.b6loop</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>__REPO_ROOT__/scripts/b6_loop_guard.zsh</string></array>
