<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.joulewise.quiet-kit</string>
<key>ProcessType</key><string>Interactive</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><false/>
<key>AbandonProcessGroup</key><true/>
<key>ExitTimeOut</key><integer>90</integer>
<key>ProgramArguments</key><array>
<string>/opt/homebrew/bin/python3.13</string><string>{{REPO}}/scripts/quiet_kit.py</string>
<string>--run</string><string>--model-python</string><string>{{MODEL_PYTHON}}</string>
</array>
<key>WorkingDirectory</key><string>{{REPO}}</string>
<key>EnvironmentVariables</key><dict>
<key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
<key>PYTHONPATH</key><string>{{REPO}}</string>
<key>PYTHONDONTWRITEBYTECODE</key><string>1</string>
<key>TMPDIR</key><string>/private/tmp/jw-quiet-kit</string>
</dict>
<key>StandardOutPath</key><string>{{ARCHIVE}}/launchd/stdout.log</string>
<key>StandardErrorPath</key><string>{{ARCHIVE}}/launchd/stderr.log</string>
</dict></plist>
