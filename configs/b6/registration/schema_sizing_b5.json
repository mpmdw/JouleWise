{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "joulewise.b5_sizing.v1",
  "type": "object",
  "required": ["schema_version", "packs"],
  "properties": {
    "schema_version": {"const": "joulewise.b5_sizing.v1"},
    "packs": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["pack_id", "programmed_span_s", "T_stream_max_s"],
        "properties": {
          "pack_id": {"type": "string"},
          "programmed_span_s": {"type": "number", "exclusiveMinimum": 0},
          "T_stream_max_s": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
