{
  "name": "lakebed",
  "version": "0.0.29",
  "description": "Agent-native CLI and runtime for building and deploying Lakebed capsules.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://lakebed.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pingdotgg/lakebed.git",
    "directory": "packages/lakebed"
  },
  "keywords": [
    "agents",
    "app-runtime",
    "cli",
    "lakebed"
  ],
  "bin": {
    "lakebed": "bin/lakebed.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./anonymous": {
      "types": "./dist/anonymous.d.ts",
      "default": "./dist/anonymous.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./command": {
      "types": "./dist/command.d.ts",
      "default": "./dist/command.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "default": "./dist/database/index.js"
    },
    "./release": {
      "types": "./dist/release.d.ts",
      "default": "./dist/release.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./source-store": {
      "types": "./dist/source-store.d.ts",
      "default": "./dist/source-store.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./subscription": {
      "types": "./dist/subscription.d.ts",
      "default": "./dist/subscription.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/sync-core.mjs --check && node scripts/clean-build.mjs && tsc -b tsconfig.json && chmod +x dist/cli.js",
    "check": "pnpm sync:core:check && pnpm typecheck && pnpm build && pnpm verify:pack",
    "dts:snapshot": "node scripts/dts-snapshot.mjs check",
    "dts:snapshot:update": "node scripts/dts-snapshot.mjs update",
    "dts:diff:base": "node scripts/dts-diff-base.mjs",
    "prepack": "pnpm build",
    "sync:core": "node scripts/sync-core.mjs",
    "sync:core:check": "node scripts/sync-core.mjs --check",
    "test:db-export": "node scripts/db-export.test.mjs",
    "test:storage": "pnpm build && node --test scripts/storage.test.mjs",
    "test:types": "tsc -p tsconfig.test-types.json",
    "typecheck": "node scripts/sync-core.mjs --check && tsc -p tsconfig.json --noEmit --tsBuildInfoFile tsconfig.typecheck.tsbuildinfo",
    "verify:pack": "node ../../scripts/verify-packed-cli.mjs"
  },
  "dependencies": {
    "esbuild": "^0.27.1",
    "preact": "^10.28.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
