{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mpmdw/JouleWise/blob/lane/2026-10-21-align-gpukit/joulewise/align/gpukit/matrix.schema.json",
  "title": "JouleWise gpukit matrix v2",
  "description": "Lane-local planning format; runner_adapter translates supported campaigns provisionally. Source data define single-stream BF16 ceilings, not benchmarks.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "kind",
    "models",
    "tasks",
    "conditions",
    "seeds",
    "episode_count",
    "measured_episode_count",
    "monitor_call_count",
    "monitor_model",
    "monitor_visibilities",
    "sampling",
    "workload",
    "gpu_classes",
    "planning_wall_seconds",
    "flags",
    "sources",
    "example_prices",
    "model_parameters",
    "lower_bound_wall_seconds",
    "rounding",
    "monitor_serving"
  ],
  "properties": {
    "schema": {
      "const": "joulewise.align.gpukit.matrix.v2"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "shade",
        "moe_stage_a",
        "budget"
      ]
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "attention",
          "revision",
          "reasoning_parser",
          "reasoning_parser_source",
          "tool_call_parser",
          "tool_call_parser_source",
          "enable_auto_tool_choice"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "attention": {
            "type": "string"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "tensor_parallel_size": {
            "type": "integer",
            "minimum": 1
          },
          "weight_precision": {
            "enum": [
              "bf16",
              "fp8"
            ]
          },
          "kv_headroom_bytes": {
            "$ref": "#/$defs/nullable_nonnegative"
          },
          "reasoning_parser": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "reasoning_parser_source": {
            "$ref": "#/$defs/citation"
          },
          "tool_call_parser": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "tool_call_parser_source": {
            "type": "string",
            "minLength": 1
          },
          "enable_auto_tool_choice": {
            "type": "boolean"
          },
          "serve_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layout_options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reasoning_parser",
                "reasoning_parser_source",
                "tool_call_parser",
                "tool_call_parser_source",
                "enable_auto_tool_choice"
              ],
              "properties": {
                "reasoning_parser": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "reasoning_parser_source": {
                  "$ref": "#/$defs/citation"
                },
                "tool_call_parser": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "tool_call_parser_source": {
                  "type": "string",
                  "minLength": 1
                },
                "enable_auto_tool_choice": {
                  "type": "boolean"
                },
                "serve_flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "tasks": {
      "$ref": "#/$defs/strings"
    },
    "conditions": {
      "$ref": "#/$defs/strings"
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer"
      }
    },
    "episode_count": {
      "$ref": "#/$defs/count"
    },
    "measured_episode_count": {
      "$ref": "#/$defs/count"
    },
    "monitor_call_count": {
      "$ref": "#/$defs/count"
    },
    "episode_count_meaning": {
      "type": "string"
    },
    "monitor_model": {
      "type": "string"
    },
    "monitor_visibilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "full",
          "no_scratchpad",
          "actions_only",
          "tampered"
        ]
      }
    },
    "sampling": {
      "type": "object",
      "required": [
        "interval_ns",
        "source"
      ],
      "properties": {
        "interval_ns": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workload": {
      "type": "object",
      "required": [
        "prefill_tokens",
        "decode_tokens",
        "tool_wait_s",
        "host_overhead_s",
        "monitor_prefill_tokens",
        "monitor_decode_tokens",
        "source"
      ],
      "properties": {
        "prefill_tokens": {
          "$ref": "#/$defs/nullable_nonnegative"
        },
        "decode_tokens": {
          "$ref": "#/$defs/nullable_nonnegative"
        },
        "tool_wait_s": {
          "$ref": "#/$defs/nullable_nonnegative"
        },
        "host_overhead_s": {
          "$ref": "#/$defs/nullable_nonnegative"
        },
        "monitor_prefill_tokens": {
          "$ref": "#/$defs/nullable_nonnegative"
        },
        "monitor_decode_tokens": {
          "$ref": "#/$defs/nullable_nonnegative"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "string"
        }
      }
    },
    "gpu_classes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "gpu_count",
          "setup_s",
          "model_load_s",
          "router_overhead_fraction",
          "source",
          "throughput",
          "hardware"
        ],
        "properties": {
          "gpu_count": {
            "type": "integer",
            "minimum": 1
          },
          "setup_s": {
            "$ref": "#/$defs/nullable_nonnegative"
          },
          "model_load_s": {
            "$ref": "#/$defs/nullable_nonnegative"
          },
          "router_overhead_fraction": {
            "$ref": "#/$defs/nullable_nonnegative"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "throughput": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "ceiling_formula",
                "source",
                "efficiency",
                "efficiency_source"
              ],
              "properties": {
                "ceiling_formula": {
                  "type": "string"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "efficiency": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "efficiency_source": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/citation"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "efficiency": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "efficiency"
                    ]
                  },
                  "then": {
                    "properties": {
                      "efficiency_source": {
                        "$ref": "#/$defs/citation"
                      }
                    }
                  }
                }
              ]
            }
          },
          "hardware": {
            "type": "object",
            "required": [
              "memory_bandwidth_bytes_s",
              "dense_bf16_flops_s",
              "memory_bytes"
            ],
            "properties": {
              "memory_bandwidth_bytes_s": {
                "$ref": "#/$defs/sourced_value"
              },
              "dense_bf16_flops_s": {
                "$ref": "#/$defs/sourced_value"
              },
              "memory_bytes": {
                "$ref": "#/$defs/sourced_value"
              }
            }
          }
        }
      }
    },
    "planning_wall_seconds": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "object"
    },
    "example_prices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "usd_per_gpu_hour",
          "url",
          "date_seen",
          "gpu_class"
        ],
        "properties": {
          "usd_per_gpu_hour": {
            "type": "number",
            "minimum": 0
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "date_seen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "gpu_class": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "fractions",
        "calibration_repetitions",
        "paired_generations",
        "live_conditions",
        "source",
        "item_source"
      ],
      "properties": {
        "fractions": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "calibration_repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "paired_generations": {
          "const": 2
        },
        "live_conditions": {
          "$ref": "#/$defs/strings"
        },
        "source": {
          "type": "string"
        },
        "item_source": {
          "type": "string"
        }
      }
    },
    "model_parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "total_parameters",
          "active_parameters",
          "source"
        ],
        "properties": {
          "total_parameters": {
            "$ref": "#/$defs/nullable_positive"
          },
          "active_parameters": {
            "$ref": "#/$defs/nullable_positive"
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/$defs/citation"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "lower_bound_wall_seconds": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      }
    },
    "rounding": {
      "type": "string",
      "minLength": 1
    },
    "judge_model": {
      "type": "string"
    },
    "monitor_serving": {
      "type": "object",
      "required": [
        "id",
        "reasoning_parser",
        "reasoning_parser_source",
        "tool_call_parser",
        "tool_call_parser_source",
        "enable_auto_tool_choice"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_parser": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reasoning_parser_source": {
          "$ref": "#/$defs/citation"
        },
        "tool_call_parser": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "tool_call_parser_source": {
          "type": "string",
          "minLength": 1
        },
        "enable_auto_tool_choice": {
          "type": "boolean"
        },
        "serve_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "budget"
          }
        }
      },
      "then": {
        "required": [
          "budget"
        ],
        "properties": {
          "conditions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "thinking_on",
                "thinking_off",
                "concise",
                "budget_1",
                "budget_0.6",
                "budget_0.4",
                "budget_0.3",
                "deletion_1",
                "deletion_0.6",
                "deletion_0.4",
                "deletion_0.3"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "conditions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "benign",
                "sabotage"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonnegative": {
      "type": "number",
      "minimum": 0
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "citation": {
      "type": "object",
      "required": [
        "url",
        "accessed"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "accessed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "nullable_positive": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "sourced_value": {
      "type": "object",
      "required": [
        "value",
        "source"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/nullable_positive"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/citation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "nullable_nonnegative": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
