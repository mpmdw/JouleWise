    "R2": {
      "condition": "Start sample <= publication < every Run sample <= Run read; verify Start before reading Run inputs",
      "grid_s": [
        0,
        1,
        2,
        3
      ]
    },
    "R3": {
      "eligible_pool": "f2-stab-01..14",
      "excluded": [
        "f2-stab-15",
        "f2-stab-16"
      ],
      "completion": [
        "kit_id",
        "pin",
        "leg_id",
        "t0_date",
        "status"
      ]
    },
    "G2": {
      "order": [
        "write claim",
        "reopen bound inputs and Start seal",
        "final live reads",
        "invoke pinned launcher once"
      ],
      "write_free_interval": "final reads through launcher invocation",
      "residual": "post-read host change and launcher-internal writes"
    },
    "L1": {
      "order": [
        "recognize adverse fact or unknown read",
        "persist digest-bound identified hold",
        "refuse",
        "verify typed disposition",
        "reevaluate current facts"
      ]
    },
    "Q1": {
      "terminal_fact": "actual lm-hp-01 execution",
      "ordinary_clear": "refuse launch",
      "correction": "lead ATTESTATION-CORRECTION in RUN_STATE with original digest and evidence of error",
      "after_correction": "reassess current evidence and remaining independent holds"
    },
    "Q2": {
      "origins": [
        "Issue",
        "Start",
        "Run",
        "FinalRun"
      ],
      "faults": [
        "missing-identity",
        "wrong-identity-digest",
        "ledger-read",
        "ledger-write",
        "in-flight"
      ],
      "scope": [
        "queue_sha",
        "queue_seq"
      ],
      "storage": "independently durable from issue journal",
      "unresolved": "HOLD_UNKNOWN",
      "recovery": "typed disposition naming the hold, source digest and position, then fresh assessment",
      "clear_read_restoration": "replacement-source also models disappearance of the original in-flight marker when the primary volume is restored"
    },
    "Q3": {
      "failed_read": [
        "source",
        "error_class",
        "attempt_time",
        "ledger_sequence"
      ],
      "source_digest": "SHA-256 of canonical failed-read bytes",
      "sequence": "disposition ledger sequence > hold ledger sequence",
      "wall_clock": "not an ordering witness",
      "order_cases": [
