{
  "$defs": {
    "axi_batch_policy": {
      "additionalProperties": false,
      "properties": {
        "admission_policy": {
          "enum": [
            "immediate",
            "admit_roster_together"
          ],
          "type": "string"
        },
        "dispatch_policy": {
          "enum": [
            "one_request_call",
            "one_native_batch_call"
          ],
          "type": "string"
        },
        "mode": {
          "enum": [
            "single_request",
            "static_batch"
          ],
          "type": "string"
        },
        "request_roster_ref": {
          "minLength": 1,
          "type": "string"
        },
        "request_roster_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "requested_batch_size": {
          "minimum": 1,
          "type": "integer"
        },
        "synchronization_policy": {
          "enum": [
            "none",
            "barrier_before_prefill"
          ],
          "type": "string"
        }
      },
      "required": [
        "admission_policy",
        "dispatch_policy",
        "mode",
        "request_roster_ref",
        "request_roster_sha256",
        "requested_batch_size",
        "synchronization_policy"
      ],
      "type": "object"
    },
    "axi_draft_model_identity": {
      "additionalProperties": false,
      "properties": {
        "model_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
