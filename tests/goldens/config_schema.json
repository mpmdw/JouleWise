  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "batch_policy"
              ]
            },
            {
              "required": [
                "speculation"
              ]
            }
          ]
        }
      },
      "if": {
        "required": [
          "schema_extensions"
        ]
      },
      "then": {
        "required": [
          "batch_policy",
          "speculation"
        ]
      }
    }
  ],
