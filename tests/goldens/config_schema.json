            "vocabulary_size": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "class",
            "name",
            "revision",
            "vocabulary_size"
          ],
          "type": "object"
        },
        "weight_format": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "model_artifact_sha256",
        "model_name",
        "model_revision",
        "quantization",
        "runtime_backend",
        "runtime_version",
        "tokenizer",
        "weight_format"
