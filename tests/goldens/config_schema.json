        "null"
      ]
    },
    "run_metadata": {
      "$ref": "#/$defs/run_metadata"
    },
    "sampling": {
      "$ref": "#/$defs/sampling"
    },
    "schema_extensions": {
      "maxItems": 1,
      "minItems": 1,
      "prefixItems": [
        {
          "const": "joulewise.axi_decode_config.v1"
        }
      ],
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "0.1",
      "minLength": 1,
      "type": "string"
    },
    "speculation": {
      "$ref": "#/$defs/axi_speculation_policy"
    },
    "workload_profile": {
      "$ref": "#/$defs/workload_profile"
    }
  },
  "required": [
    "schema_version",
    "model",
    "quantization",
    "hardware_target",
    "workload_profile"
