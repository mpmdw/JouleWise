          "pattern": "\\S",
          "type": "string"
        },
        "output_tokens": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "prompt_text": {
          "minLength": 1,
          "pattern": "\\S",
          "type": [
            "string",
            "null"
