    "hardware_target": {
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "ssh"
              }
            },
            "required": [
              "transport"
            ]
          },
          "then": {
            "properties": {
              "host": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "host"
            ]
          }
        }
      ],
      "properties": {
        "device_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "minLength": 1,
          "pattern": "\\S",
          "type": [
            "string",
