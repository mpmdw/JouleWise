                  }
                },
                "prompt_tokens": {
                  "type": "null"
                },
                "suite_manifest_ref": {
                  "type": "null"
                }
              },
              "required": [
                "prompt_text"
              ]
            },
            {
              "properties": {
                "dataset_ref": {
                  "type": "null"
                },
                "prompt_text": {
                  "type": "null"
                },
                "prompt_tokens": {
