          "type": [
            "object",
            "null"
          ]
        },
        "max_proposed_tokens": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "off",
            "draft_model",
            "native_mtp"
          ],
          "type": "string"
        },
        "native_mtp_identity": {
          "additionalProperties": false,
          "properties": {
            "draft_depth": {
              "minimum": 1,
              "type": "integer"
            },
            "head_configuration": {
              "minProperties": 1,
              "type": "object"
            },
            "head_configuration_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "head_count": {
              "minimum": 1,
              "type": "integer"
            },
            "target_model_artifact_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "draft_depth",
            "head_configuration",
            "head_configuration_sha256",
            "head_count",
            "target_model_artifact_sha256"
          ],
          "type": [
            "object",
            "null"
          ]
        }
