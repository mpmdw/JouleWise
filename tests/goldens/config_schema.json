                  "minLength": 1,
                  "type": "string"
                },
                "name": {
                  "minLength": 1,
                  "type": "string"
                },
                "revision": {
                  "minLength": 1,
                  "type": "string"
                },
                "vocabulary_size": {
                  "minimum": 1,
                  "type": "integer"
